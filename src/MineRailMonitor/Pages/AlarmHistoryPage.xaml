<UserControl x:Class="MineRailMonitor.Pages.AlarmHistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="AlarmHeaderStyle" TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
            <Setter Property="Background" Value="#06223A" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style x:Key="AlarmSectionBorderStyle" TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
            <Setter Property="Background" Value="#03182B" />
            <Setter Property="BorderBrush" Value="#0D6792" />
            <Setter Property="Padding" Value="9" />
        </Style>
        <Style x:Key="AlarmSummaryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#061F36" />
            <Setter Property="BorderBrush" Value="#15516E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style x:Key="AlarmSummaryNumberStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="AlarmSummaryLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="AlarmActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="#0A3F65" />
            <Setter Property="BorderBrush" Value="#168EDC" />
        </Style>
        <Style x:Key="AlarmFooterButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="82" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource AlarmHeaderStyle}" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource AlarmBrush}" CornerRadius="2" Margin="0,8,12,8" />
                <TextBlock Grid.Column="1" Text="报警记录" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="聚焦脱节报警，查看真实识别结果与清除状态"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                           VerticalAlignment="Center" Margin="18,0,0,0" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource AlarmSectionBorderStyle}" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="开始时间" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <DatePicker x:Name="FromDatePicker" Width="168" Height="30" Margin="0,0,14,0"
                                Style="{StaticResource HmiDatePickerStyle}"
                                SelectedDateFormat="Short"
                                ToolTip="点击选择开始日期" PreviewMouseLeftButtonDown="OnDatePickerPreviewMouseLeftButtonDown" />
                    <TextBlock Text="结束时间" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <DatePicker x:Name="ToDatePicker" Width="168" Height="30" Margin="0,0,14,0"
                                Style="{StaticResource HmiDatePickerStyle}"
                                SelectedDateFormat="Short"
                                ToolTip="点击选择结束日期" PreviewMouseLeftButtonDown="OnDatePickerPreviewMouseLeftButtonDown" />
                    <TextBlock Text="基站" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="StationFilter" Width="190" Height="30" Margin="0,0,14,0" />
                    <TextBlock Text="车头RFID" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="HeadRfidFilter" Width="126" Height="30" Margin="0,0,14,0" ToolTip="例如：0003 或 0x0003" />
                    <Button x:Name="QueryButton" Content="查询" Width="78" Height="30" MinHeight="30" Background="#087DDD" BorderBrush="#16B8FF" Click="OnQueryClick" />
                    <Button x:Name="ResetButton" Content="重置" Width="78" Height="30" MinHeight="30" Margin="8,0,0,0" Click="OnResetClick" />
                </WrapPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock x:Name="QueryErrorText" Foreground="#FFFF9B9B" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,8">
            <Border Style="{StaticResource AlarmSummaryCardStyle}" Margin="0,0,6,0" BorderBrush="#A43754">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource AlarmIconGeometry}" Width="28" Height="28" Stretch="Uniform"
                          Stroke="{StaticResource AlarmBrush}" StrokeThickness="1.8" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TodayAlarmValue" Text="0" Style="{StaticResource AlarmSummaryNumberStyle}" Foreground="{StaticResource AlarmBrush}" />
                        <TextBlock Text="今日报警" Style="{StaticResource AlarmSummaryLabelStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource AlarmSummaryCardStyle}" Margin="0,0,6,0" BorderBrush="#167EB3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource QueryIconGeometry}" Width="28" Height="28" Stretch="Uniform"
                          Stroke="{StaticResource PrimaryBlueBrush}" StrokeThickness="1.8" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="QueryAlarmValue" Text="0" Style="{StaticResource AlarmSummaryNumberStyle}" Foreground="{StaticResource PrimaryBlueBrush}" />
                        <TextBlock Text="当前查询" Style="{StaticResource AlarmSummaryLabelStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource AlarmSummaryCardStyle}" Margin="0,0,6,0" BorderBrush="#008F8A">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource CommunicationIconGeometry}" Width="28" Height="28" Stretch="Uniform"
                          Stroke="{StaticResource SuccessBrush}" StrokeThickness="1.8" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="StationCountValue" Text="0" Style="{StaticResource AlarmSummaryNumberStyle}" Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock Text="涉及基站" Style="{StaticResource AlarmSummaryLabelStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource AlarmSummaryCardStyle}" BorderBrush="#A36A22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource TrainIconGeometry}" Width="28" Height="28" Stretch="Uniform"
                          Stroke="{StaticResource WarningBrush}" StrokeThickness="1.8" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="LatestAlarmStationValue" Text="-" Style="{StaticResource AlarmSummaryNumberStyle}" FontSize="18" Foreground="{StaticResource WarningBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="最近报警基站" Style="{StaticResource AlarmSummaryLabelStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>

        <Border Grid.Row="3" Style="{StaticResource AlarmSectionBorderStyle}" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="38" />
                </Grid.RowDefinitions>
                <Grid Margin="6,0,6,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="4" Height="22" Background="{StaticResource AlarmBrush}" CornerRadius="2" Margin="0,0,10,0" />
                        <TextBlock Text="报警记录列表" Style="{StaticResource SectionTitleStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="ListSummaryText" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                </Grid>
                <Grid Grid.Row="1">
                    <DataGrid x:Name="AlarmGrid" Style="{StaticResource IndustrialDataGridStyle}"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="报警时间" Binding="{Binding AlarmTimeText}" Width="1.25*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            <DataGridTextColumn Header="基站" Binding="{Binding StationText}" Width="1.35*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            <DataGridTextColumn Header="车头RFID" Binding="{Binding HeadRfidText}" Width="0.8*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            <DataGridTextColumn Header="识别进度" Binding="{Binding ProgressText}" Width="0.85*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            <DataGridTextColumn Header="缺少节数" Binding="{Binding MissingCountText}" Width="0.75*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            <DataGridTextColumn Header="报警原因" Binding="{Binding AlarmReasonText}" Width="1.15*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            <DataGridTextColumn Header="清除状态" Binding="{Binding ClearStateText}" Width="0.9*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            <DataGridTemplateColumn Header="详情" Width="0.65*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="查看" Tag="{Binding}" Style="{StaticResource AlarmActionButtonStyle}" Click="OnAlarmDetailsClick" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="NoDataText" Text="暂无报警记录" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" IsHitTestVisible="False" />
                </Grid>
                <DockPanel Grid.Row="2" LastChildFill="False" Margin="6,8,6,0">
                    <TextBlock Text="仅显示脱节报警 · 每页 20 条" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                    <Button x:Name="NextPageButton" DockPanel.Dock="Right" Content="下一页 ›" Style="{StaticResource AlarmFooterButtonStyle}" Click="OnNextPageClick" />
                    <Button x:Name="PreviousPageButton" DockPanel.Dock="Right" Content="‹ 上一页" Style="{StaticResource AlarmFooterButtonStyle}" Margin="8,0,0,0" Click="OnPreviousPageClick" />
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
