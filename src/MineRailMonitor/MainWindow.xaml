<Window x:Class="MineRailMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="矿山轨道运输监控系统"
        Width="1440" Height="900" WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="False" Padding="0" BorderThickness="0"
        WindowState="Maximized" MinWidth="1280" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Microsoft YaHei UI"
        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="OnWindowLoaded" StateChanged="OnWindowStateChanged" Closing="OnWindowClosing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="60" ResizeBorderThickness="6" GlassFrameThickness="0"
                                  CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBackgroundGradientBrush}"
                BorderBrush="{StaticResource HeaderAccentBrush}" BorderThickness="0,0,0,2"
                MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect Color="#00B8FF" BlurRadius="12" ShadowDepth="0" Opacity="0.5" />
            </Border.Effect>
            <Grid Margin="28,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="480" />
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="132" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="48" Height="48" Margin="0,0,14,0">
                        <Path Data="{StaticResource TrainIconGeometry}" Width="46" Height="46" Stretch="Uniform"
                              Fill="#168EDC" Stroke="#4BDEFF" StrokeThickness="1.8" StrokeLineJoin="Round">
                            <Path.Effect>
                                <DropShadowEffect Color="#008DFF" BlurRadius="16" ShadowDepth="0" Opacity="0.9" />
                            </Path.Effect>
                        </Path>
                    </Grid>
                    <TextBlock Text="矿山轨道运输监控系统" FontSize="32" FontWeight="Bold"
                               Foreground="#F3F8FF" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="安全运输 · 精准感知 · 智能运维"
                           Foreground="#35D7FF" FontSize="14" VerticalAlignment="Center" />

                <Grid Grid.Column="2">
                    <StackPanel x:Name="NormalStatusPanel" Orientation="Horizontal" Margin="0"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <Ellipse x:Name="HeaderSystemStatusDot" Style="{StaticResource HeaderStatusDotStyle}" />
                            <TextBlock x:Name="HeaderSystemStatusText" Text="系统状态未知" Style="{StaticResource HeaderStatusTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <Ellipse x:Name="HeaderRfidStatusDot" Style="{StaticResource HeaderStatusDotStyle}" />
                            <TextBlock x:Name="RfidStationStatusText" Text="RFID监听未启动" Style="{StaticResource HeaderStatusTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="HeaderExternalStatusDot" Style="{StaticResource HeaderStatusDotStyle}" />
                            <TextBlock x:Name="HeaderExternalStatusText" Text="外部接口未接入" Style="{StaticResource HeaderStatusTextStyle}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="AdminModeBanner" Orientation="Horizontal" Visibility="Collapsed"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="管理员模式 · 地图可编辑" Foreground="#FFE28A" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button Content="退出管理员模式" Margin="16,0,0,0" Padding="10,4"
                                WindowChrome.IsHitTestVisibleInChrome="True" Click="OnExitAdminModeClick" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Column="3" Margin="0,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="98" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="HeaderDateSeparator" Width="1" Height="72" Background="#168DD3"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0.9"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <RotateTransform Angle="28" />
                        </Border.RenderTransform>
                    </Border>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0">
                        <TextBlock x:Name="CurrentDateText" Text="----/--/--" FontSize="12" Foreground="#AEDBFF" HorizontalAlignment="Right" />
                        <TextBlock x:Name="CurrentWeekdayText" Text="星期-" FontSize="11" Foreground="#7DB5E0" HorizontalAlignment="Right" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="1" Height="42" Background="#23577D" VerticalAlignment="Center" />
                    <TextBlock x:Name="CurrentTimeText" Grid.Column="2" Text="--:--:--" FontSize="24"
                               FontWeight="SemiBold" Foreground="#F3F8FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="MinimizeWindowButton" Style="{StaticResource WindowCommandButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMinimizeClick"
                            AutomationProperties.Name="最小化">
                        <Path Data="{StaticResource MinimizeIconGeometry}" Style="{StaticResource WindowCommandIconStyle}" />
                    </Button>
                    <Button x:Name="MaximizeWindowButton" Style="{StaticResource WindowCommandButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMaximizeClick"
                            AutomationProperties.Name="最大化或还原">
                        <Grid Width="16" Height="16">
                            <Path Data="{StaticResource MaximizeIconGeometry}">
                                <Path.Style>
                                    <Style TargetType="Path" BasedOn="{StaticResource WindowCommandIconStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <Path Data="{StaticResource RestoreIconGeometry}">
                                <Path.Style>
                                    <Style TargetType="Path" BasedOn="{StaticResource WindowCommandIconStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Grid>
                    </Button>
                    <Button x:Name="CloseWindowButton" Style="{StaticResource WindowCloseButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCloseClick"
                            AutomationProperties.Name="关闭">
                        <Path Data="{StaticResource CloseIconGeometry}" Style="{StaticResource WindowCommandIconStyle}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}" BorderBrush="#0B7DB3" BorderThickness="0,0,1,0" Margin="0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="0" />
                    </Grid.RowDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6,14,6,10">
                            <Button x:Name="MonitorNavButton" Tag="Monitor" Style="{StaticResource NavButtonStyle}" Click="OnNavigationClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE80F;" Style="{StaticResource SegoeFluentIconStyle}" />
                                    <TextBlock Text="实时监控" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Tag="Rfid" Style="{StaticResource NavButtonStyle}" Click="OnNavigationClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A5;" Style="{StaticResource SegoeFluentIconStyle}" />
                                    <TextBlock Text="RFID统计" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Tag="Alarms" Style="{StaticResource NavButtonStyle}" Click="OnNavigationClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource SegoeFluentIconStyle}" />
                                    <TextBlock Text="报警记录" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Tag="History" Style="{StaticResource NavButtonStyle}" Click="OnNavigationClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE81C;" Style="{StaticResource SegoeFluentIconStyle}" />
                                    <TextBlock Text="历史查询" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Tag="Communication" Style="{StaticResource NavButtonStyle}" Click="OnNavigationClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE701;" Style="{StaticResource SegoeFluentIconStyle}" />
                                    <TextBlock Text="通信测试" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Tag="Settings" Style="{StaticResource NavButtonStyle}" Click="OnNavigationClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" Style="{StaticResource SegoeFluentIconStyle}" />
                                    <TextBlock Text="系统设置" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Border Height="1" Background="#138AC2" Margin="12,16,12,12" />
                            <StackPanel Orientation="Horizontal" Margin="18,0,0,8">
                                <Path Data="{StaticResource TrainIconGeometry}" Width="20" Height="20" Stretch="Uniform"
                                      Stroke="#64CFFF" StrokeThickness="1.7" Fill="Transparent" Margin="0,0,10,0" />
                                <TextBlock Text="站场选择" FontSize="15" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel x:Name="StationButtonsPanel" />
                            <Button Tag="Overview" Style="{StaticResource StationButtonStyle}" Click="OnNavigationClick" Content="全局总览" />
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="1" Margin="18,0,12,10" Style="{StaticResource PanelBorderStyle}"
                            Visibility="Collapsed"
                            Background="{StaticResource MapBackdropBrush}" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="30" />
                                <RowDefinition Height="22" />
                            </Grid.RowDefinitions>
                            <Image x:Name="StationPreviewImage" Stretch="Uniform" Opacity="0.82" />
                            <Border Grid.Row="1" Background="#0A2940" BorderBrush="#0D83BD" BorderThickness="1" CornerRadius="3" Margin="4,2">
                                <TextBlock Text="三维视图（参考）" Foreground="#35C9FF" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Row="2" Text="矿山智能运输 · 高效 · 安全 · 绿色" Foreground="#5EA2CF"
                                       FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <ContentControl x:Name="PageContent" Grid.Column="1" />
        </Grid>
    </Grid>
</Window>
