<Window x:Class="MineRailMonitor.Pages.UnsavedSettingsChangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="未保存设置"
        Width="470"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource TextPrimaryBrush}"
        ShowInTaskbar="False">
    <Border x:Name="DialogBorder"
            Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource WarningBrush}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="6,6,0,0">
                <Grid>
                    <TextBlock Text="未保存设置"
                               Margin="16,0,48,0"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               MouseLeftButtonDown="OnHeaderMouseLeftButtonDown" />
                    <Button Content="×"
                            Width="40"
                            Height="32"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,5,0"
                            Padding="0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Click="OnCancelClick" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Padding="22,20,22,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36"
                                Height="36"
                                CornerRadius="18"
                                BorderBrush="{StaticResource WarningBrush}"
                                Background="#5B4812"
                                BorderThickness="1">
                            <TextBlock Text="!"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Arial"
                                       FontSize="21"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource WarningBrush}" />
                        </Border>
                        <TextBlock x:Name="MessageText"
                                   Margin="14,0,0,0"
                                   MaxWidth="360"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="保存并继续" Width="100" Height="32" Margin="0,0,8,0" IsDefault="True" Click="OnSaveAndContinueClick" />
                        <Button Content="放弃修改" Width="88" Height="32" Margin="0,0,8,0" Click="OnDiscardClick" />
                        <Button Content="取消" Width="62" Height="32" Click="OnCancelClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
