<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <add key="RfidUdpListenAddress" value="127.0.0.1" />
    <add key="RfidUdpListenPort" value="62002" />
    <add key="EmptyRfidValue" value="0" />
    <!-- Keep empty in source. Set AdminPassword only in a local, uncommitted config or use MINE_RAIL_ADMIN_PASSWORD. -->
    <add key="AdminPassword" value="" />
  </appSettings>
</configuration>
