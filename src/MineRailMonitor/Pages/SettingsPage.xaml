<UserControl x:Class="MineRailMonitor.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MineRailMonitor.Pages"
             Background="{StaticResource AppBackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="SettingsPanelStyle" TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
            <Setter Property="Background" Value="#041B30" />
            <Setter Property="BorderBrush" Value="#0B7EBA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="SettingsPageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource PageTitleStyle}">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitleStyle}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SettingsFieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SettingsHelperStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Background" Value="#061E33" />
            <Setter Property="BorderBrush" Value="#21698F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="SettingsActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="#0A2B46" />
            <Setter Property="BorderBrush" Value="#1A79A8" />
        </Style>

        <Style x:Key="SettingsPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentButtonBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBlueBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SettingsDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsActionButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
            <Setter Property="Background" Value="#211A2A" />
            <Setter Property="Padding" Value="12,0" />
        </Style>

        <Style x:Key="SettingsTableHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
            <Setter Property="Foreground" Value="#BBD8EA" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0" />
        </Style>

        <Style x:Key="SettingsTableTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource SettingsTextBoxStyle}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="#082A45" />
            <Setter Property="BorderBrush" Value="#1B5B7E" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0B304C" />
                    <Setter Property="BorderBrush" Value="#2B86B5" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="#0B304C" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBlueBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsTableComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="#082A45" />
            <Setter Property="BorderBrush" Value="#1B5B7E" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SettingsTableActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsDangerButtonStyle}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Width" Value="72" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="SettingsToggleStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="ToggleTrack" Width="38" Height="20" Background="#19374D" BorderBrush="#39627B" BorderThickness="1" CornerRadius="10">
                                <Ellipse x:Name="ToggleThumb" Width="14" Height="14" Fill="#A9C1D0" HorizontalAlignment="Left" Margin="2" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" Content="{TemplateBinding Content}" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="{TemplateBinding FontSize}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleTrack" Property="Background" Value="{StaticResource SuccessBrush}" />
                                <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                <Setter TargetName="ToggleThumb" Property="Fill" Value="#F4FFFB" />
                                <Setter TargetName="ToggleThumb" Property="Margin" Value="20,2,2,2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ToggleTrack" Property="Opacity" Value="0.55" />
                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,20,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xE713;" Style="{StaticResource SegoeFluentIconStyle}" Foreground="{StaticResource PrimaryBlueBrush}" FontSize="28" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock Grid.Column="1" Text="系统设置" Style="{StaticResource SettingsPageTitleStyle}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="›" Foreground="{StaticResource MutedTextBrush}" FontSize="24" VerticalAlignment="Center" Margin="18,0,18,0" />
            <TextBlock Grid.Column="3" Text="系统参数配置" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource SettingsPanelStyle}" Margin="0,0,0,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE713;" Style="{StaticResource SegoeFluentIconStyle}" Foreground="{StaticResource PrimaryBlueBrush}" FontSize="38" Width="42" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="RFID识别参数" Style="{StaticResource SettingsSectionTitleStyle}" />
                                <TextBlock Text="设置 RFID 识别相关的核心参数，影响系统的识别效率和准确性。" Style="{StaticResource SettingsHelperStyle}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" Background="{StaticResource GridLineBrush}" />

                        <Grid Grid.Row="2" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="270" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderBrush="{StaticResource GridLineBrush}" BorderThickness="0,0,1,0" Padding="0,0,22,0" Margin="0,0,22,0">
                                <StackPanel>
                                    <TextBlock Text="RFID轮询间隔（ms）" Style="{StaticResource SettingsFieldLabelStyle}" />
                                    <TextBox x:Name="PollIntervalTextBox" Style="{StaticResource SettingsTextBoxStyle}" Margin="0,8,0,9" />
                                    <TextBlock Text="控制系统读取RFID设备的轮询时间间隔，建议范围 100-1000ms。" Style="{StaticResource SettingsHelperStyle}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" BorderBrush="{StaticResource GridLineBrush}" BorderThickness="0,0,1,0" Padding="0,0,22,0" Margin="0,0,22,0">
                                <StackPanel>
                                    <TextBlock Text="标准列车节数（含车头）" Style="{StaticResource SettingsFieldLabelStyle}" />
                                    <TextBox x:Name="ExpectedVehicleCountTextBox" Style="{StaticResource SettingsTextBoxStyle}" Margin="0,8,0,9" />
                                    <TextBlock Text="提示：包含车头（1个车头 + 10个车厢），用于计算标准识别节数。" Style="{StaticResource SettingsHelperStyle}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" BorderBrush="{StaticResource GridLineBrush}" BorderThickness="0,0,1,0" Padding="0,0,22,0" Margin="0,0,22,0">
                                <StackPanel>
                                    <TextBlock Text="相邻车辆识别超时（秒）" Style="{StaticResource SettingsFieldLabelStyle}" />
                                    <TextBox x:Name="InterVehicleTimeoutTextBox" Style="{StaticResource SettingsTextBoxStyle}" Margin="0,8,0,9" />
                                    <TextBlock Text="相邻两辆车的识别时间超限，判定为断开，建议范围 10-60秒。" Style="{StaticResource SettingsHelperStyle}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Padding="20,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="参数说明" Style="{StaticResource SettingsFieldLabelStyle}" Margin="0,0,0,8" />
                                    <TextBlock Text="请根据现场实际情况调整参数。修改后请点击“保存设置”使配置生效。" Style="{StaticResource SettingsHelperStyle}" />
                                    <Border Background="#0A2B45" CornerRadius="3" Padding="10" Margin="0,16,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE73E;" Style="{StaticResource SegoeFluentIconStyle}" Foreground="{StaticResource SuccessBrush}" FontSize="18" Margin="0,0,8,0" />
                                            <StackPanel>
                                                <TextBlock Text="当前配置可用" Foreground="{StaticResource SuccessBrush}" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="保存后参数将应用于运行时。" Style="{StaticResource SettingsHelperStyle}" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="StationEditorPanel" Grid.Row="1" Style="{StaticResource SettingsPanelStyle}" Margin="0,0,0,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE701;" Style="{StaticResource SegoeFluentIconStyle}" Foreground="{StaticResource PrimaryBlueBrush}" FontSize="35" Width="40" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="RFID独立基站端点配置" Style="{StaticResource SettingsSectionTitleStyle}" />
                                <TextBlock Text="配置各个独立基站的网络参数，每个基站使用独立的 IP、端口和协议地址。" Style="{StaticResource SettingsHelperStyle}" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button x:Name="AddStationButton" Grid.Column="2" Content="＋  新增基站" Style="{StaticResource SettingsPrimaryButtonStyle}" Width="132"
                                    IsEnabled="{Binding StationEditingEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPage}}}"
                                    Click="OnAddStationClick" />
                        </Grid>

                        <Border Grid.Row="1" Background="{StaticResource GridLineBrush}" Margin="0,8,0,0" />

                        <TextBlock Grid.Row="2" Text="启用的基站才会参与数据采集与识别；设备协议地址由现场协议确定（Byte2=03），端点完全相同时不允许保存。" Style="{StaticResource SettingsHelperStyle}" Margin="0,11,0,12" />

                        <Grid Grid.Row="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#082A45" BorderBrush="{StaticResource GridLineBrush}" BorderThickness="1" CornerRadius="2">
                                <Grid Height="30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.55*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1.35*" />
                                        <ColumnDefinition Width="1.55*" />
                                        <ColumnDefinition Width="0.75*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1.35*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="序号" Style="{StaticResource SettingsTableHeaderStyle}" TextAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="基站编号" Style="{StaticResource SettingsTableHeaderStyle}" />
                                    <TextBlock Grid.Column="2" Text="基站名称" Style="{StaticResource SettingsTableHeaderStyle}" />
                                    <TextBlock Grid.Column="3" Text="IP地址" Style="{StaticResource SettingsTableHeaderStyle}" />
                                    <TextBlock Grid.Column="4" Text="端口" Style="{StaticResource SettingsTableHeaderStyle}" />
                                    <TextBlock Grid.Column="5" Text="设备协议地址（Byte2）" Style="{StaticResource SettingsTableHeaderStyle}" />
                                    <TextBlock Grid.Column="6" Text="启用状态" Style="{StaticResource SettingsTableHeaderStyle}" />
                                    <TextBlock Grid.Column="7" Text="操作" Style="{StaticResource SettingsTableHeaderStyle}" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Height="300" BorderBrush="{StaticResource GridLineBrush}" BorderThickness="1,0,1,1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="StationsItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#061F34" BorderBrush="{StaticResource GridLineBrush}" BorderThickness="0,0,0,1" Padding="0,2">
                                                    <Grid MinHeight="42">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="0.55*" />
                                                            <ColumnDefinition Width="1.1*" />
                                                            <ColumnDefinition Width="1.35*" />
                                                            <ColumnDefinition Width="1.55*" />
                                                            <ColumnDefinition Width="0.75*" />
                                                            <ColumnDefinition Width="0.9*" />
                                                            <ColumnDefinition Width="1*" />
                                                            <ColumnDefinition Width="1.35*" />
                                                        </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding DisplayIndex}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <ComboBox Grid.Column="1" Style="{StaticResource SettingsTableComboBoxStyle}" Margin="0,0,8,0"
                                                              IsEnabled="{Binding StationEditingEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPage}}}"
                                                              ItemsSource="{Binding StationIdOptions}"
                                                              SelectedItem="{Binding StationId, UpdateSourceTrigger=PropertyChanged}"
                                                              IsEditable="False" VerticalAlignment="Center" ToolTip="请选择稳定的基站编号" />
                                                    <TextBox Grid.Column="2" Style="{StaticResource SettingsTableTextBoxStyle}" Margin="0,0,8,0"
                                                             IsEnabled="{Binding StationEditingEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPage}}}"
                                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" ToolTip="基站名称" />
                                                    <TextBox Grid.Column="3" Style="{StaticResource SettingsTableTextBoxStyle}" Margin="0,0,8,0"
                                                             IsEnabled="{Binding StationEditingEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPage}}}"
                                                             Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" ToolTip="IP地址" />
                                                    <TextBox Grid.Column="4" Style="{StaticResource SettingsTableTextBoxStyle}" Margin="0,0,8,0"
                                                             IsEnabled="{Binding StationEditingEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPage}}}"
                                                             Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" ToolTip="端口" />
                                                    <TextBox Grid.Column="5" Style="{StaticResource SettingsTableTextBoxStyle}" Margin="0,0,8,0"
                                                             IsEnabled="{Binding StationEditingEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPage}}}"
                                                             Text="{Binding ProtocolAddress}" IsReadOnly="True" Focusable="False"
                                                             VerticalAlignment="Center" ToolTip="按现场协议表固定为03，不可编辑" />
                                                    <CheckBox Grid.Column="6" Content="启用" Style="{StaticResource SettingsToggleStyle}"
                                                              IsEnabled="{Binding StationEditingEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPage}}}"
                                                              IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                                              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" />
                                                    <Button Grid.Column="7" Content="移除" Style="{StaticResource SettingsTableActionButtonStyle}" HorizontalAlignment="Left"
                                                            IsEnabled="{Binding StationEditingEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPage}}}"
                                                            Click="OnRemoveStationClick" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,0,0,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="保存设置" Style="{StaticResource SettingsPrimaryButtonStyle}" Width="142" Click="OnSaveClick" />
                        <Button Content="进入管理员模式" Style="{StaticResource SettingsActionButtonStyle}" Width="160" Margin="12,0,0,0" Click="OnEnterAdminModeClick" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#061F34" BorderBrush="{StaticResource GridLineBrush}" BorderThickness="1" CornerRadius="4" Padding="16,11" Margin="28,0,0,0">
                        <StackPanel>
                            <TextBlock Text="配置提示" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="1. 修改网络参数后，建议先进行通信测试，确认基站可正常通信。&#x0a;2. 只有启用的基站才会参与数据采集与识别。&#x0a;3. 如遇通信异常，请检查 IP 地址、端口和防火墙设置。" Style="{StaticResource SettingsHelperStyle}" LineHeight="18" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock x:Name="ValidationText" Grid.Row="3" Foreground="#FF8795" TextWrapping="Wrap" Margin="0,0,0,18" />
        </Grid>
    </Grid>
</UserControl>
