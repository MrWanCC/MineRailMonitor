<UserControl x:Class="MineRailMonitor.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="系统设置" Style="{StaticResource PageTitleStyle}" />
        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource PanelBorderStyle}" Padding="20">
                    <StackPanel Width="440" HorizontalAlignment="Left">
                        <TextBlock Text="RFID 识别参数" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
                        <TextBlock Text="RFID轮询间隔（ms）" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox x:Name="PollIntervalTextBox" Margin="0,6,0,14" />
                        <TextBlock Text="标准列车节数（含车头）" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="提示：包含车头（1个车头 + 10个车厢）" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0" />
                        <TextBox x:Name="ExpectedVehicleCountTextBox" Margin="0,6,0,14" />
                        <TextBlock Text="相邻车辆识别超时（秒）" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox x:Name="InterVehicleTimeoutTextBox" Margin="0,6,0,14" />
                    </StackPanel>
                </Border>

                <Border x:Name="StationEditorPanel" Margin="0,18,0,0" Style="{StaticResource PanelBorderStyle}" Padding="20">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <TextBlock Text="RFID独立基站端点" FontSize="18" FontWeight="SemiBold" />
                            <Button x:Name="AddStationButton" Content="新增基站" Width="110" HorizontalAlignment="Right" Click="OnAddStationClick" />
                        </DockPanel>
                        <TextBlock Text="每个站使用自己的 IP、端口和协议地址；启用的行必须完整填写。协议地址按十六进制填写。" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="125" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="85" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="基站编号" />
                            <TextBlock Grid.Column="1" Text="基站名称" />
                            <TextBlock Grid.Column="2" Text="IP地址" />
                            <TextBlock Grid.Column="3" Text="端口" />
                            <TextBlock Grid.Column="4" Text="协议地址" />
                            <TextBlock Grid.Column="5" Text="启用状态" />
                            <TextBlock Grid.Column="6" Text="操作" />
                        </Grid>
                        <ItemsControl x:Name="StationsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="125" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="85" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="70" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Margin="0,0,8,0" Text="{Binding StationId, UpdateSourceTrigger=PropertyChanged}" ToolTip="基站编号" />
                                        <TextBox Grid.Column="1" Margin="0,0,8,0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="基站名称" />
                                        <TextBox Grid.Column="2" Margin="0,0,8,0" Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" ToolTip="IP地址" />
                                        <TextBox Grid.Column="3" Margin="0,0,8,0" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" ToolTip="端口" />
                                        <TextBox Grid.Column="4" Margin="0,0,8,0" Text="{Binding ProtocolAddress, UpdateSourceTrigger=PropertyChanged}" ToolTip="协议地址" />
                                        <CheckBox Grid.Column="5" Content="启用" IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                                        <Button Grid.Column="6" Content="移除" Click="OnRemoveStationClick" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ValidationText" Foreground="#FF8795" TextWrapping="Wrap" Margin="0,18,0,12" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
                    <Button Content="保存设置" Width="110" Click="OnSaveClick" />
                    <Button Content="进入管理员模式" Margin="12,0,0,0" Click="OnEnterAdminModeClick" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
