    <ProjectReference Include="..\MineRailMonitor.Infrastructure\MineRailMonitor.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
