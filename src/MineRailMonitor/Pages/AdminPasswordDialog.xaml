<Window x:Class="MineRailMonitor.Pages.AdminPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="管理员验证" Width="360" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource CardBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="24" Background="{StaticResource CardBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="管理员验证" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18" />
        <StackPanel Grid.Row="1">
            <TextBlock Text="密码" />
            <PasswordBox x:Name="PasswordInput" Margin="0,6,0,0" />
        </StackPanel>
        <TextBlock x:Name="ErrorText" Grid.Row="2" Text="管理员密码错误" Foreground="#FF8795"
                   Visibility="Collapsed" Margin="0,10,0,0" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="确认" Width="76" IsDefault="True" Click="OnConfirmClick" />
            <Button Content="取消" Width="76" Margin="10,0,0,0" IsCancel="True" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
