<UserControl x:Class="MineRailMonitor.Pages.RfidStatisticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="StatisticsTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,2"
                                CornerRadius="4,4,0,0" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                                <Border x:Name="SelectedIndicator" Height="2"
                                        Background="{StaticResource PrimaryBlueBrush}"
                                        CornerRadius="1" VerticalAlignment="Bottom" Opacity="0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#0B314C" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource PrimaryBlueBrush}" />
                                <Setter TargetName="SelectedIndicator" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#09263D" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatisticsTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource StatisticsTabItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.DirectionalNavigation="Contained">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#041B2E" BorderBrush="{StaticResource GridLineBrush}"
                                    BorderThickness="0,0,0,1" CornerRadius="4,4,0,0" Padding="4,2">
                                <TabPanel IsItemsHost="True" />
                            </Border>
                            <Border Grid.Row="1" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatisticsSectionStyle" TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
            <Setter Property="Background" Value="#03182B" />
            <Setter Property="BorderBrush" Value="#0D6792" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style x:Key="StatisticsMetricStyle" TargetType="Border">
            <Setter Property="Background" Value="#061F36" />
            <Setter Property="BorderBrush" Value="#15516E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="StatisticsMetricNumberStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
            <Setter Property="FontSize" Value="25" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="StatisticsPageGrid" VerticalAlignment="Stretch" Margin="12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#06223A" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="5" Padding="14,0" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource HeaderAccentBrush}" CornerRadius="2" Margin="0,8,12,8" />
                <TextBlock Grid.Column="1" Text="统计分析" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center" />
                <Grid Grid.Column="2" Margin="18,0,0,0">
                    <TextBlock x:Name="StatisticsSubtitleText" Text="统计范围：全部站场"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="StatisticsErrorText" Foreground="{StaticResource AlarmBrush}"
                               FontSize="12" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
                <Button x:Name="RefreshButton" Grid.Column="3" Content="刷新" Width="78" Height="30"
                        MinHeight="30" Click="OnRefreshClick" />
            </Grid>
        </Border>

        <TabControl x:Name="StatisticsTabs" Grid.Row="1" Style="{StaticResource StatisticsTabControlStyle}" SelectedIndex="0">
            <TabItem Header="今日概览">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="4,0,4,6">
                        <TextBlock x:Name="StatisticsDateText" Text="统计日期：—"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <UniformGrid Grid.Row="1" Columns="6">
                        <Border Style="{StaticResource StatisticsMetricStyle}" BorderBrush="#167EB3">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="PassageMetricValue" Text="0" Style="{StaticResource StatisticsMetricNumberStyle}" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="通行次数" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatisticsMetricStyle}" BorderBrush="#008F8A">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="NormalMetricValue" Text="0" Style="{StaticResource StatisticsMetricNumberStyle}" Foreground="{StaticResource SuccessBrush}" />
                                <TextBlock Text="正常通过" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatisticsMetricStyle}" BorderBrush="#A43754">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="AlarmMetricValue" Text="0" Style="{StaticResource StatisticsMetricNumberStyle}" Foreground="{StaticResource AlarmBrush}" />
                                <TextBlock Text="脱节报警" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatisticsMetricStyle}" BorderBrush="#A8792A">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="UnverifiedMetricValue" Text="0" Style="{StaticResource StatisticsMetricNumberStyle}" Foreground="#E8AD52" />
                                <TextBlock Text="完整性未判定" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatisticsMetricStyle}" BorderBrush="#A43754">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="AlarmRateMetricValue" Text="0.0%" Style="{StaticResource StatisticsMetricNumberStyle}" Foreground="{StaticResource AlarmBrush}" />
                                <TextBlock Text="报警率" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatisticsMetricStyle}" BorderBrush="#167EB3" Margin="0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="AverageMetricValue" Text="0.0 秒" Style="{StaticResource StatisticsMetricNumberStyle}" Foreground="{StaticResource PrimaryBlueBrush}" />
                                <TextBlock Text="平均通行时长" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="0.9*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource StatisticsSectionStyle}" Margin="0,0,8,0">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Top" Text="最近通行记录"
                                           Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"
                                           FontWeight="SemiBold" Margin="0,0,0,10" />
                                <Grid>
                                    <DataGrid x:Name="RecentPassagesGrid" Style="{StaticResource IndustrialDataGridStyle}"
                                              AutoGenerateColumns="False" HeadersVisibility="Column" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="0.85*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                            <DataGridTextColumn Header="车辆编号" Binding="{Binding VehicleNoText}" Width="0.8*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                            <DataGridTextColumn Header="车辆名称" Binding="{Binding VehicleNameText}" Width="1.1*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                            <DataGridTextColumn Header="判定结果" Binding="{Binding OutcomeText}" Width="0.9*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                            <DataGridTextColumn Header="实际/理论" Binding="{Binding CountText}" Width="0.8*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                            <DataGridTextColumn Header="报警状态" Binding="{Binding AlarmStatusText}" Width="0.8*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel x:Name="OverviewEmptyPanel" HorizontalAlignment="Center"
                                                VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False">
                                        <TextBlock x:Name="OverviewEmptyTitleText" Text="今日暂无通行记录" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="OverviewSummaryText"
                                                   Text="通行次数按完成时间统计；报警率按脱节报警/(正常通过+脱节报警)计算，不含完整性未判定。"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                                   Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460" />
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource StatisticsSectionStyle}" Margin="8,0,0,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="报警状态" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <Border Background="#071F34" BorderBrush="#15516E" BorderThickness="1"
                                        CornerRadius="4" Padding="12,14" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="未确认" Foreground="{StaticResource AlarmBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="UnconfirmedAlarmCountValue" Text="0" Grid.Column="1"
                                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="20"
                                                   FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                                <Border Background="#071F34" BorderBrush="#15516E" BorderThickness="1"
                                        CornerRadius="4" Padding="12,14" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="已确认" Foreground="#E8AD52" VerticalAlignment="Center" />
                                        <TextBlock x:Name="AcknowledgedAlarmCountValue" Text="0" Grid.Column="1"
                                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="20"
                                                   FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                                <Border Background="#071F34" BorderBrush="#15516E" BorderThickness="1"
                                        CornerRadius="4" Padding="12,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="已恢复" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="RecoveredAlarmCountValue" Text="0" Grid.Column="1"
                                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="20"
                                                   FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="车辆统计">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="4,0,4,6">
                        <TextBlock x:Name="VehicleStatisticsDateText" Text="按车辆编号汇总今日通行和报警情况"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <DataGrid x:Name="VehicleStatisticsGrid" Style="{StaticResource IndustrialDataGridStyle}"
                                  AutoGenerateColumns="False" HeadersVisibility="Column" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="车辆编号" Binding="{Binding VehicleNoText}" Width="1.1*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                <DataGridTextColumn Header="车辆名称" Binding="{Binding VehicleNameText}" Width="1.4*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                <DataGridTextColumn Header="通行次数" Binding="{Binding TotalCount}" Width="0.9*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                <DataGridTextColumn Header="报警次数" Binding="{Binding AlarmCount}" Width="0.9*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                <DataGridTextColumn Header="报警率" Binding="{Binding AlarmRateText}" Width="0.9*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="VehicleGridEmptyText" Text="暂无车辆统计数据"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"
                                   IsHitTestVisible="False" Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
