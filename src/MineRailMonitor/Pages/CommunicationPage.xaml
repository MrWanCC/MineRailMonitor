<UserControl x:Class="MineRailMonitor.Pages.CommunicationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="CommunicationHeaderStyle" TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
            <Setter Property="Background" Value="#06223A" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style x:Key="CommunicationSectionStyle" TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
            <Setter Property="Background" Value="#03182B" />
            <Setter Property="BorderBrush" Value="#0D6792" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style x:Key="CommunicationPacketCardStyle" TargetType="Border" BasedOn="{StaticResource CommunicationSectionStyle}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#041C30" />
        </Style>
        <Style x:Key="CommunicationPacketHeaderStyle" TargetType="Border">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="#072B45" />
            <Setter Property="BorderBrush" Value="{StaticResource GridLineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style x:Key="CommunicationLogStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="CommunicationMetricLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CommunicationMetricValueStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldValueStyle}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CommunicationActionButtonStyle" TargetType="Button" BasedOn="{StaticResource MapToolButtonStyle}">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="58" />
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="54" />
        </Grid.RowDefinitions>

        <Border x:Name="CommunicationHeaderBar" Grid.Row="0" Style="{StaticResource CommunicationHeaderStyle}" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="5" Height="30" Background="{StaticResource HeaderAccentBrush}" CornerRadius="2" Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="通信测试" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="RFID 基站端点 · UDP 报文 · 协议解析"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="站场范围" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="YardFilter" Width="132" Height="30" Margin="0,0,8,0"
                              SelectionChanged="OnYardFilterChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="测试基站" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="TestStationSelector" Width="210" Height="30" Margin="0,0,8,0" SelectionChanged="OnTestStationSelectionChanged" />
                    <Button x:Name="ReadTestButton" Content="发送读取" Width="88" Style="{StaticResource CommunicationActionButtonStyle}"
                            Background="#087DDD" BorderBrush="#16B8FF" Click="OnReadTestClick" />
                    <Button x:Name="ClearTestButton" Content="发送清空" Width="88" Style="{StaticResource CommunicationActionButtonStyle}"
                            Margin="8,0,0,0" Background="#744B2A" BorderBrush="#D58D3B"
                            IsEnabled="False" ToolTip="进入管理员模式后可发送清空命令" Click="OnClearTestClick" />
                    <Button Content="清空日志" Width="78" Style="{StaticResource CommunicationActionButtonStyle}"
                            Margin="8,0,0,0" Click="OnClearLogClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="CommunicationStatusBar" Grid.Row="1" Style="{StaticResource CommunicationSectionStyle}" Padding="12,0" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Ellipse x:Name="ListenerStatusDot" Width="14" Height="14" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,9,0" />
                    <TextBlock Text="监听状态" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="ListenerStatusText" Foreground="{StaticResource SuccessBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border Grid.Column="1" Width="1" Height="28" Background="{StaticResource GridLineBrush}" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock Text="最近有效报文" Style="{StaticResource CommunicationMetricLabelStyle}" />
                    <TextBlock x:Name="LatestPacketTimeText" Text="-" Style="{StaticResource CommunicationMetricValueStyle}" FontFamily="Consolas" />
                </StackPanel>
                <Border Grid.Column="3" Width="1" Height="28" Background="{StaticResource GridLineBrush}" />
                <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock Text="当前测试基站" Style="{StaticResource CommunicationMetricLabelStyle}" />
                    <TextBlock x:Name="SelectedStationText" Text="-" Style="{StaticResource CommunicationMetricValueStyle}" FontSize="12" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="5" Text="UDP 实时收发 · 报文解析状态实时更新"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border x:Name="CommunicationOverviewBar" Grid.Row="2" Style="{StaticResource CommunicationSectionStyle}" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#062B45" BorderBrush="{StaticResource GridLineBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,4,0" Padding="12,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="基站总数" Style="{StaticResource CommunicationMetricLabelStyle}" Margin="0,0,14,0" />
                        <TextBlock x:Name="OverviewStationCountText" Text="0" Style="{StaticResource CommunicationMetricValueStyle}" Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#062B45" BorderBrush="{StaticResource GridLineBrush}" BorderThickness="1" CornerRadius="4" Margin="4,0" Padding="12,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="{StaticResource SuccessBrush}" Margin="0,0,9,0" />
                        <TextBlock Text="在线基站" Style="{StaticResource CommunicationMetricLabelStyle}" Margin="0,0,14,0" />
                        <TextBlock x:Name="OverviewOnlineCountText" Text="0" Style="{StaticResource CommunicationMetricValueStyle}" Foreground="{StaticResource SuccessBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#062B45" BorderBrush="{StaticResource GridLineBrush}" BorderThickness="1" CornerRadius="4" Margin="4,0" Padding="12,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="{StaticResource AlarmBrush}" Margin="0,0,9,0" />
                        <TextBlock Text="离线基站" Style="{StaticResource CommunicationMetricLabelStyle}" Margin="0,0,14,0" />
                        <TextBlock x:Name="OverviewOfflineCountText" Text="0" Style="{StaticResource CommunicationMetricValueStyle}" Foreground="{StaticResource AlarmBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Background="#2A2111" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="4" Margin="4,0,0,0" Padding="12,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="当前累计超时次数" Style="{StaticResource CommunicationMetricLabelStyle}" Margin="0,0,14,0" />
                        <TextBlock x:Name="OverviewTimeoutCountText" Text="0" Style="{StaticResource CommunicationMetricValueStyle}" Foreground="{StaticResource WarningBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="1.85*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CommunicationSectionStyle}" Margin="0,0,8,0" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="154" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="4" Height="22" Background="{StaticResource HeaderAccentBrush}" CornerRadius="2" Margin="0,0,10,0" />
                        <TextBlock Text="基站通信状态" Style="{StaticResource SectionTitleStyle}" />
                    </StackPanel>
                    <DataGrid x:Name="StationStatusGrid" Grid.Row="1" Style="{StaticResource IndustrialDataGridStyle}"
                              AutoGenerateColumns="False" HeadersVisibility="Column" IsReadOnly="True"
                              SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="OnStationSelectionChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="基站" Binding="{Binding StationText}" Width="150" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            <DataGridTextColumn Header="协议地址" Binding="{Binding ProtocolAddressText}" Width="72" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            <DataGridTextColumn Header="IP / 端口" Binding="{Binding EndpointText}" Width="140" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="70" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            <DataGridTextColumn Header="最后发送" Binding="{Binding LastSentText}" Width="92" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            <DataGridTextColumn Header="最后接收" Binding="{Binding LastReceivedText}" Width="92" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            <DataGridTextColumn Header="响应耗时" Binding="{Binding ResponseMillisecondsText}" Width="78" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            <DataGridTextColumn Header="发送" Binding="{Binding SentCountText}" Width="62" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            <DataGridTextColumn Header="接收" Binding="{Binding ReceivedCountText}" Width="62" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            <DataGridTextColumn Header="超时" Binding="{Binding TimeoutCountText}" Width="62" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            <DataGridTextColumn Header="连续超时" Binding="{Binding ConsecutiveTimeoutCountText}" Width="78" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            <DataGridTextColumn Header="最后错误" Binding="{Binding LastErrorText}" Width="150" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="NoStationText" Grid.Row="1" Text="暂无已配置 RFID 基站"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" IsHitTestVisible="False" />
                    <Border x:Name="SelectedDiagnosticCard" Grid.Row="2" Background="#061E31" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,8,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="选中基站诊断" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
                            <UniformGrid Grid.Row="1" Rows="3" Columns="4">
                                <StackPanel Margin="0,1,8,1">
                                    <TextBlock Text="基站名称" Style="{StaticResource CommunicationMetricLabelStyle}" />
                                    <TextBlock x:Name="SelectedDiagnosticStationText" Text="-" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Margin="0,1,8,1">
                                    <TextBlock Text="YardId" Style="{StaticResource CommunicationMetricLabelStyle}" />
                                    <TextBlock x:Name="SelectedDiagnosticYardText" Text="-" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Margin="0,1,8,1">
                                    <TextBlock Text="IP" Style="{StaticResource CommunicationMetricLabelStyle}" />
                                    <TextBlock x:Name="SelectedDiagnosticIpText" Text="-" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontFamily="Consolas" />
                                </StackPanel>
                                <StackPanel Margin="0,1,0,1">
                                    <TextBlock Text="端口" Style="{StaticResource CommunicationMetricLabelStyle}" />
                                    <TextBlock x:Name="SelectedDiagnosticPortText" Text="-" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontFamily="Consolas" />
                                </StackPanel>
                                <StackPanel Margin="0,1,8,1">
                                    <TextBlock Text="协议地址" Style="{StaticResource CommunicationMetricLabelStyle}" />
                                    <TextBlock x:Name="SelectedDiagnosticProtocolText" Text="-" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontFamily="Consolas" />
                                </StackPanel>
                                <StackPanel Margin="0,1,8,1">
                                    <TextBlock Text="实时状态" Style="{StaticResource CommunicationMetricLabelStyle}" />
                                    <TextBlock x:Name="SelectedDiagnosticStateText" Text="-" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Margin="0,1,8,1">
                                    <TextBlock Text="最后发送" Style="{StaticResource CommunicationMetricLabelStyle}" />
                                    <TextBlock x:Name="SelectedDiagnosticLastSentText" Text="-" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontFamily="Consolas" />
                                </StackPanel>
                                <StackPanel Margin="0,1,0,1">
                                    <TextBlock Text="最后接收" Style="{StaticResource CommunicationMetricLabelStyle}" />
                                    <TextBlock x:Name="SelectedDiagnosticLastReceivedText" Text="-" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontFamily="Consolas" />
                                </StackPanel>
                                <StackPanel Margin="0,1,8,1">
                                    <TextBlock Text="最近响应耗时" Style="{StaticResource CommunicationMetricLabelStyle}" />
                                    <TextBlock x:Name="SelectedDiagnosticResponseText" Text="-" Foreground="{StaticResource AccentBrush}" FontSize="11" FontFamily="Consolas" />
                                </StackPanel>
                                <StackPanel Margin="0,1,8,1">
                                    <TextBlock Text="连续超时" Style="{StaticResource CommunicationMetricLabelStyle}" />
                                    <TextBlock x:Name="SelectedDiagnosticConsecutiveTimeoutText" Text="0" Foreground="{StaticResource WarningBrush}" FontSize="11" FontFamily="Consolas" />
                                </StackPanel>
                                <StackPanel Margin="0,1,8,1">
                                    <TextBlock Text="最后错误" Style="{StaticResource CommunicationMetricLabelStyle}" />
                                    <TextBlock x:Name="SelectedDiagnosticErrorText" Text="无" Foreground="{StaticResource WarningBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Margin="0,1,0,1">
                                    <TextBlock Text="通信统计" Style="{StaticResource CommunicationMetricLabelStyle}" />
                                    <TextBlock x:Name="SelectedDiagnosticCountsText" Text="发送 0 · 接收 0 · 超时 0" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" />
                                </StackPanel>
                            </UniformGrid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="210" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="LatestTxCard" Grid.Column="0" Style="{StaticResource CommunicationPacketCardStyle}" Margin="0,0,4,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Style="{StaticResource CommunicationPacketHeaderStyle}" Background="#073B39">
                                <DockPanel>
                                    <TextBlock Text="最近 TX（发送报文）" Foreground="{StaticResource SuccessBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock x:Name="LatestTxTimeText" Text="-" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <StackPanel Grid.Row="1" Margin="10,8">
                                <TextBlock x:Name="LatestTxSummaryText" Text="暂无发送报文" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="LatestTxLengthText" Text="-" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,5,0,6" />
                                <Border Background="#061C2C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,8">
                                    <TextBlock x:Name="LatestTxHexText" Text="-" Style="{StaticResource CommunicationLogStyle}" Foreground="{StaticResource TextSecondaryBrush}" MaxHeight="54" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border x:Name="LatestRxCard" Grid.Column="1" Style="{StaticResource CommunicationPacketCardStyle}" Margin="4,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Style="{StaticResource CommunicationPacketHeaderStyle}" Background="#07304A">
                                <DockPanel>
                                    <TextBlock Text="最近 RX（接收报文）" Foreground="{StaticResource AccentBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock x:Name="LatestRxTimeText" Text="-" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <StackPanel Grid.Row="1" Margin="10,8">
                                <TextBlock x:Name="LatestRxSummaryText" Text="暂无接收报文" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="LatestRxLengthText" Text="-" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,5,0,6" />
                                <Border Background="#061C2C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,8">
                                    <TextBlock x:Name="LatestRxHexText" Text="-" Style="{StaticResource CommunicationLogStyle}" Foreground="{StaticResource TextSecondaryBrush}" MaxHeight="54" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Border x:Name="CurrentFrameCard" Grid.Row="1" Style="{StaticResource CommunicationPacketCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="100" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource CommunicationPacketHeaderStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="4" Height="20" Background="{StaticResource HeaderAccentBrush}" CornerRadius="2" Margin="0,0,9,0" />
                                <TextBlock Text="当前报文解析" Style="{StaticResource SectionTitleStyle}" FontSize="14" />
                            </StackPanel>
                        </Border>
                        <Grid Grid.Row="1" Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#061E31" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="9,4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="协议地址" Style="{StaticResource CommunicationMetricLabelStyle}" />
                                    <TextBlock x:Name="FrameAddressText" Grid.Column="1" Text="-" Style="{StaticResource CommunicationMetricValueStyle}" FontSize="12" Margin="8,0,0,0" />
                                    <TextBlock Grid.Row="1" Text="模式" Style="{StaticResource CommunicationMetricLabelStyle}" />
                                    <TextBlock x:Name="FrameModeText" Grid.Row="1" Grid.Column="1" Text="-" Style="{StaticResource CommunicationMetricValueStyle}" FontSize="12" Margin="8,0,0,0" />
                                    <TextBlock Grid.Row="2" Text="帧长度" Style="{StaticResource CommunicationMetricLabelStyle}" />
                                    <TextBlock x:Name="FrameLengthText" Grid.Row="2" Grid.Column="1" Text="-" Style="{StaticResource CommunicationMetricValueStyle}" FontSize="12" Margin="8,0,0,0" />
                                    <TextBlock Grid.Row="3" Text="有效 RFID" Style="{StaticResource CommunicationMetricLabelStyle}" />
                                    <TextBlock x:Name="FrameCountText" Grid.Row="3" Grid.Column="1" Text="-" Style="{StaticResource CommunicationMetricValueStyle}" FontSize="12" Margin="8,0,0,0" />
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Background="#061E31" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="8,0" Padding="6">
                                <ItemsControl x:Name="FrameRfidSlotsItemsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource GridLineBrush}" BorderThickness="0,0,1,1" Padding="8,0">
                                                <TextBlock Text="{Binding}" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <Border Grid.Column="2" Background="#061E31" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="9,4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="CRC" Style="{StaticResource CommunicationMetricLabelStyle}" />
                                    <TextBlock x:Name="FrameCrcText" Grid.Row="0" Text="-" Style="{StaticResource CommunicationMetricValueStyle}" FontSize="12" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Row="1" Text="解析结果" Style="{StaticResource CommunicationMetricLabelStyle}" />
                                    <TextBlock x:Name="FrameParseResultText" Grid.Row="1" Text="-" Foreground="{StaticResource SuccessBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    <TextBlock x:Name="FrameDescriptionText" Grid.Row="2" Text="暂无报文" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                        <Border Grid.Row="2" BorderBrush="{StaticResource GridLineBrush}" BorderThickness="0,1,0,0" Padding="8,4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="22" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="报文日志（最近 50 条）" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                <ListBox x:Name="RxListBox" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource TextPrimaryBrush}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0,2" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource CommunicationLogStyle}" FontSize="10" MaxHeight="28" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="LatestRxText" Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border x:Name="CommunicationStatsBar" Grid.Row="4" Style="{StaticResource CommunicationSectionStyle}" Padding="12,0" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock Text="▣" Foreground="{StaticResource AccentBrush}" FontSize="20" Margin="0,0,10,0" />
                    <TextBlock Text="当前通信统计" Style="{StaticResource SectionTitleStyle}" FontSize="14" />
                </StackPanel>
                <Border Grid.Column="1" Width="1" Height="28" Background="{StaticResource GridLineBrush}" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock Text="已配置基站" Style="{StaticResource CommunicationMetricLabelStyle}" />
                    <TextBlock x:Name="ConfiguredStationCountText" Text="0" Style="{StaticResource CommunicationMetricValueStyle}" Foreground="{StaticResource AccentBrush}" />
                </StackPanel>
                <Border Grid.Column="3" Width="1" Height="28" Background="{StaticResource GridLineBrush}" />
                <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock Text="日志条数" Style="{StaticResource CommunicationMetricLabelStyle}" />
                    <TextBlock x:Name="PacketLogCountText" Text="0 / 50" Style="{StaticResource CommunicationMetricValueStyle}" Foreground="{StaticResource SuccessBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="5" Text="选择基站后可发送读取 / 清空命令，收到数据后将在右侧显示原始帧与解析结果。"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
