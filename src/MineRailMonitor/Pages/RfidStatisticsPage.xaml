<UserControl x:Class="MineRailMonitor.Pages.RfidStatisticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="StatisticsEmptyStateTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style x:Key="StatisticsSectionStyle" TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
            <Setter Property="Background" Value="#041A2D" />
            <Setter Property="BorderBrush" Value="#15506B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="StatisticsTableStyle" TargetType="DataGrid" BasedOn="{StaticResource IndustrialDataGridStyle}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="RowHeight" Value="25" />
            <Setter Property="ColumnHeaderHeight" Value="26" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="StatisticsTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#0B314C" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource PrimaryBlueBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#09263D" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatisticsPageTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource StatisticsTabItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local"
                              KeyboardNavigation.DirectionalNavigation="Contained">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#041B2E" BorderBrush="{StaticResource GridLineBrush}"
                                    BorderThickness="0,0,0,1" Padding="4,2">
                                <TabPanel IsItemsHost="True" />
                            </Border>
                            <Border Grid.Row="1" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="KpiMetricTemplate">
            <Border Background="#061F36" BorderBrush="#17435B" BorderThickness="1"
                    CornerRadius="3" Padding="9,8" Margin="0,0,7,0" MinHeight="104">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{Binding AccentBrush}" CornerRadius="1" />
                    <Grid Grid.Column="1" Margin="9,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12" />
                        <TextBlock Grid.Row="1" Text="{Binding ValueText}" Foreground="{Binding AccentBrush}"
                                   FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="2" Text="{Binding DeltaText}" Foreground="{Binding DeltaBrush}"
                                   FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="3" Text="{Binding ComparisonText}" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="StationQualityKpiTemplate">
            <Border Background="#061F36" BorderBrush="#17435B" BorderThickness="1"
                    Padding="8,6" Margin="0,0,6,0" MinHeight="74">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{Binding AccentBrush}" />
                    <Grid Grid.Column="1" Margin="8,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="1" Text="{Binding ValueText}" Foreground="{Binding AccentBrush}"
                                   FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="2" Text="{Binding SubtitleText}" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="9" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
        <Style x:Key="StationQualityListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="StationRow" Background="{TemplateBinding Background}"
                                BorderBrush="#12384E" BorderThickness="0,0,0,1" Padding="4,4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="StationRow" Property="Background" Value="#0B314C" />
                                <Setter TargetName="StationRow" Property="BorderBrush" Value="{StaticResource PrimaryBlueBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StationRow" Property="Background" Value="#09263D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="StationQualityStationTemplate">
            <Grid MinHeight="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="15" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="1" Background="#15506B" HorizontalAlignment="Center" />
                <Ellipse Width="8" Height="8" Fill="#041A2D" Stroke="{Binding CompletenessBrush}"
                         StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="5,0,4,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding StationLabel}" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="{Binding PassageText}" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="10" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding CompletenessText}" Foreground="{Binding CompletenessBrush}"
                                   FontSize="10" FontWeight="SemiBold" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding MissingText}" Foreground="#EF7050" FontSize="10" />
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding AttentionText}" Foreground="#E8AD52" FontSize="9"
                               FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding MostMissingText}" Foreground="#EF7050" FontSize="9"
                               HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="StationProfileMetricTemplate">
            <Border BorderBrush="#17435B" BorderThickness="0,0,1,0" Padding="7,3" Margin="0,0,2,0">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="9" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ValueText}" Foreground="{Binding AccentBrush}"
                               FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="AlarmStatusTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" Foreground="{Binding AccentBrush}"
                           VerticalAlignment="Center" FontSize="11" />
                <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding BarWidth, Mode=OneWay}"
                             Height="7" BorderThickness="0" Background="#0B2C43"
                             Foreground="{Binding AccentBrush}" VerticalAlignment="Center"
                             IsHitTestVisible="False" />
                <TextBlock Grid.Column="2" Text="{Binding CountText}" Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock Grid.Column="3" Text="{Binding PercentText}" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="RankingItemTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="46" />
                </Grid.ColumnDefinitions>
                <Border Width="25" Height="21" Background="#0B314C" CornerRadius="2"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RankText}" Foreground="{Binding RankBrush}"
                               FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,5,0">
                    <TextBlock Text="{Binding LabelText}" Foreground="{StaticResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" FontSize="11" />
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding BarWidth, Mode=OneWay}" Height="5"
                                 BorderThickness="0" Background="#0B2C43" Foreground="{Binding BarBrush}"
                                 Margin="0,3,0,0" IsHitTestVisible="False" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding CountText}" Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" />
                <TextBlock Grid.Column="3" Text="{Binding ShareText}" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="RecentAlarmTemplate">
            <Border BorderBrush="#153B52" BorderThickness="0,0,0,1" Padding="0,4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="10" />
                    <TextBlock Grid.Column="1" Text="{Binding AlarmStatusText}" Foreground="{Binding PriorityBrush}"
                               FontSize="10" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Text="{Binding StationText}" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="11" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AlarmSummaryText}"
                               Foreground="{Binding PriorityBrush}" FontSize="10" HorizontalAlignment="Right"
                               Margin="6,0,0,0" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ExceptionItemTemplate">
            <Border BorderBrush="#153B52" BorderThickness="0,0,0,1" Padding="0,5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="10" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding OutcomeText}" Foreground="{Binding PriorityBrush}"
                               FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding AlarmStatusText}" Foreground="{Binding PriorityBrush}"
                               FontSize="10" FontWeight="SemiBold" Margin="4,0,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LocationText}"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding CountText}"
                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="10"
                               HorizontalAlignment="Right" Margin="4,0,0,0" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="StatisticsPageGrid" VerticalAlignment="Stretch" Margin="12,10">
        <ScrollViewer x:Name="StatisticsScrollViewer" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid MinHeight="{Binding ViewportHeight, ElementName=StatisticsScrollViewer}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#06223A" BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1" Padding="12,0" Margin="0,0,0,8" Height="48">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource HeaderAccentBrush}" Margin="0,8,12,8" />
                        <TextBlock Grid.Column="1" Text="统计分析" Style="{StaticResource PageTitleStyle}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="StatisticsScopeText" Grid.Column="2" Text="统计范围：全部站场"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                   VerticalAlignment="Center" Margin="16,0,8,0" TextTrimming="CharacterEllipsis" />
                        <ComboBox x:Name="TimeRangeSelector" Grid.Column="3" Width="112" Height="30"
                                  VerticalAlignment="Center" SelectionChanged="OnPeriodSelectionChanged">
                            <ComboBoxItem Content="今日" Tag="Today" />
                            <ComboBoxItem Content="昨日" Tag="Yesterday" />
                            <ComboBoxItem Content="最近7天" Tag="Last7Days" />
                            <ComboBoxItem Content="最近30天" Tag="Last30Days" />
                        </ComboBox>
                        <Button Grid.Column="4" Content="刷新" Width="68" Height="30" Margin="8,0,8,0"
                                Click="OnRefreshClick" />
                        <TextBlock x:Name="UpdatedAtText" Grid.Column="5" Text="数据更新：—"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                   VerticalAlignment="Center" MinWidth="112" TextAlignment="Right" />
                    </Grid>
                </Border>

                <TextBlock Grid.Row="1" x:Name="StatisticsErrorText" Foreground="{StaticResource AlarmBrush}"
                           FontSize="12" Margin="4,0,4,6" Visibility="Collapsed" TextWrapping="Wrap" />

                <TabControl x:Name="StatisticsPageTabs" Grid.Row="2"
                            Style="{StaticResource StatisticsPageTabControlStyle}" SelectedIndex="0">
                    <TabItem Header="基站标签统计">
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ItemsControl Grid.Row="0" x:Name="StationQualityKpisItemsControl"
                                          ItemTemplate="{StaticResource StationQualityKpiTemplate}" Margin="0,0,0,7">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <Grid Grid.Row="1" MinHeight="390">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="2.1*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource StatisticsSectionStyle}" Margin="0,0,5,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                            <TextBlock Text="沿线基站识别质量" Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock x:Name="StationQualitySummaryText" Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" Margin="8,0,0,0" />
                                        </DockPanel>
                                        <Grid Grid.Row="1">
                                            <ListBox x:Name="StationQualityListBox" Background="Transparent" BorderThickness="0"
                                                     ItemContainerStyle="{StaticResource StationQualityListItemStyle}"
                                                     ItemTemplate="{StaticResource StationQualityStationTemplate}"
                                                     SelectionChanged="OnStationQualitySelectionChanged"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                            <TextBlock x:Name="StationQualityEmptyText" Text="当前范围暂无基站通行记录"
                                                       Style="{StaticResource StatisticsEmptyStateTextStyle}"
                                                       Visibility="Collapsed" />
                                        </Grid>
                                        <Border Grid.Row="2" x:Name="FocusStationPanel" Background="#10283A" BorderBrush="#9C6734"
                                                BorderThickness="1,1,1,1" Padding="9,7" Margin="0,8,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="FocusStationAccent" Background="#E8AD52" />
                                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                    <TextBlock x:Name="FocusStationTitleText" Text="重点关注基站" Foreground="#E8AD52" FontSize="10"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock x:Name="FocusStationNameText" Text="暂无可判定基站"
                                                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"
                                                               FontWeight="SemiBold" Margin="0,3,0,2" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="FocusStationCompletenessText" Text="完整率 —"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"
                                                                   Margin="0,0,12,0" />
                                                        <TextBlock x:Name="FocusStationMissingText" Text="缺失 —"
                                                                   Foreground="#EF7050" FontSize="10" Margin="0,0,12,0" />
                                                        <TextBlock x:Name="FocusStationPassagesText" Text="通行 —"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource StatisticsSectionStyle}" Margin="5,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                            <TextBlock x:Name="SelectedStationTitleText" Text="基站识别质量"
                                                       Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"
                                                       FontWeight="SemiBold" />
                                        </DockPanel>
                                        <ItemsControl Grid.Row="1" x:Name="StationProfileItemsControl"
                                                      ItemTemplate="{StaticResource StationProfileMetricTemplate}"
                                                      Margin="0,0,0,7">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><UniformGrid Columns="8" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                        <Border Grid.Row="2" x:Name="StationTagRankingPanel"
                                                BorderBrush="#15506B" BorderThickness="0,1,0,1"
                                                Padding="0,6" MinHeight="90" VerticalAlignment="Top">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="标签出现趟数排行" Foreground="{StaticResource TextPrimaryBrush}"
                                                           FontSize="12" FontWeight="SemiBold" Margin="0,0,0,3" />
                                                <Grid Grid.Row="1">
                                                    <ItemsControl x:Name="StationTagRankingItemsControl"
                                                                  ItemTemplate="{StaticResource RankingItemTemplate}" />
                                                    <TextBlock x:Name="StationTagRankingEmptyText" Text="当前基站暂无标签记录"
                                                               Style="{StaticResource StatisticsEmptyStateTextStyle}"
                                                               Visibility="Collapsed" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <Grid Grid.Row="3" Margin="0,6,0,0" MinHeight="150">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="标签明细" Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5" />
                                            <DataGrid Grid.Row="1" x:Name="StationTagStatisticsGrid"
                                                      Style="{StaticResource StatisticsTableStyle}" Visibility="Collapsed">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="车辆 / 标签类型" Binding="{Binding RfidText}" Width="1.4*" />
                                                    <DataGridTextColumn Header="出现通行趟数" Binding="{Binding PassageCountText}" Width="1.2*" />
                                                    <DataGridTextColumn Header="首次观察" Binding="{Binding FirstSeenAtText}" Width="1.3*" />
                                                    <DataGridTextColumn Header="最近观察" Binding="{Binding LastSeenAtText}" Width="1.3*" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <TextBlock Grid.Row="1" x:Name="StationTagDetailEmptyText" Text="当前基站暂无标签记录"
                                                       Style="{StaticResource StatisticsEmptyStateTextStyle}"
                                                       Visibility="Collapsed" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                            <Border Grid.Row="2" Background="#041A2D" BorderBrush="#17435B" BorderThickness="1"
                                    Padding="8,5" Margin="0,7,0,0" ToolTip="基于 Passage 快照统计；同一趟中同一 RFID 仅计一次；不代表原始读卡帧数。">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="统计口径 ⓘ" Foreground="{StaticResource AccentBrush}"
                                               FontSize="10" FontWeight="SemiBold" Margin="0,0,10,0" />
                                    <TextBlock Text="基于 Passage 快照统计；同一趟中同一 RFID 仅计一次；不代表原始读卡帧数。"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem Header="统计总览">
                        <Grid x:Name="StatisticsOverviewGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1.2*" />
                                <RowDefinition Height="1*" />
                            </Grid.RowDefinitions>
                <ItemsControl Grid.Row="0" x:Name="KpiMetricsItemsControl" ItemTemplate="{StaticResource KpiMetricTemplate}"
                              Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <Grid Grid.Row="1" x:Name="DashboardMainGrid" MinHeight="320" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.15*" />
                        <ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="1.05*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="TrendPanel" Grid.Column="0" Style="{StaticResource StatisticsSectionStyle}"
                            Margin="0,0,5,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{StaticResource AccentBrush}" Width="44"
                                    HorizontalAlignment="Left" />
                            <DockPanel Grid.Row="1" Margin="0,7,0,7">
                                <TextBlock Text="通行趋势" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="16" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="■ 通行次数" Foreground="{StaticResource PrimaryBlueBrush}" FontSize="10" Margin="8,0,0,0" />
                                    <TextBlock Text="■ 脱节报警" Foreground="{StaticResource AlarmBrush}" FontSize="10" Margin="8,0,0,0" />
                                    <TextBlock Text="━ 报警率" Foreground="#E8AD52" FontSize="10" Margin="8,0,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <Grid x:Name="TrendSummaryGrid" Grid.Row="2" Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="高峰时段" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                                    <TextBlock x:Name="TrendPeakPeriodText" Text="—" Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="14" FontWeight="SemiBold" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#23516A" Height="28" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                    <TextBlock Text="最高通行" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                                    <TextBlock x:Name="TrendPeakPassageText" Text="—" Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="14" FontWeight="SemiBold" />
                                </StackPanel>
                                <Border Grid.Column="3" Background="#23516A" Height="28" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="4" Margin="10,0,0,0">
                                    <TextBlock Text="报警集中时段" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                                    <TextBlock x:Name="TrendAlarmPeakText" Text="—" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="14" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="3" MinHeight="190">
                                <Canvas x:Name="TrendChartCanvas" SizeChanged="OnTrendChartSizeChanged" />
                                <TextBlock x:Name="TrendEmptyText" Text="暂无趋势数据"
                                           Style="{StaticResource StatisticsEmptyStateTextStyle}"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid x:Name="AlarmSummaryColumn" Grid.Column="1" Margin="5,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.05*" />
                            <RowDefinition Height="0.95*" />
                        </Grid.RowDefinitions>
                        <Border x:Name="AlarmSummaryPanel" Grid.Row="0" Style="{StaticResource StatisticsSectionStyle}"
                                Margin="0,0,0,4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="2" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{StaticResource AlarmBrush}" Width="36"
                                        HorizontalAlignment="Left" />
                                <TextBlock Grid.Row="1" Text="告警状态概况" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="15" FontWeight="SemiBold" Margin="0,7,0,3" />
                                <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,3">
                                    <TextBlock Text="总告警" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11" VerticalAlignment="Bottom" Margin="0,0,7,3" />
                                    <TextBlock x:Name="AlarmTotalText" Text="—" Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="26" FontWeight="SemiBold" />
                                </StackPanel>
                                <ItemsControl x:Name="AlarmStatusItemsControl" Grid.Row="3"
                                              ItemTemplate="{StaticResource AlarmStatusTemplate}" />
                            </Grid>
                        </Border>
                        <Border x:Name="RecentAlarmsPanel" Grid.Row="1" Style="{StaticResource StatisticsSectionStyle}"
                                Margin="0,4,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="2" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{StaticResource AlarmBrush}" Width="36"
                                        HorizontalAlignment="Left" />
                                <TextBlock Grid.Row="1" Text="最近报警" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="15" FontWeight="SemiBold" Margin="0,7,0,2" />
                                <Grid Grid.Row="2">
                                    <ItemsControl x:Name="RecentAlarmsItemsControl" ItemTemplate="{StaticResource RecentAlarmTemplate}"
                                                  VerticalAlignment="Top" />
                                    <TextBlock x:Name="RecentAlarmsEmptyText" Text="暂无报警"
                                               Style="{StaticResource StatisticsEmptyStateTextStyle}"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border x:Name="RankingPanel" Grid.Column="2" Style="{StaticResource StatisticsSectionStyle}"
                            Margin="5,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{StaticResource AccentBrush}" Width="44"
                                    HorizontalAlignment="Left" />
                            <TextBlock Grid.Row="1" Text="问题排名" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="16" FontWeight="SemiBold" Margin="0,7,0,2" />
                            <TabControl x:Name="RankingTabs" Grid.Row="2"
                                        ItemContainerStyle="{StaticResource StatisticsTabItemStyle}"
                                        Background="Transparent" BorderThickness="0" SelectedIndex="0">
                                <TabItem Header="报警最多基站">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ItemsControl x:Name="AlarmStationRankingItemsControl" ItemTemplate="{StaticResource RankingItemTemplate}"
                                                      VerticalAlignment="Top" />
                                        <TextBlock x:Name="AlarmStationRankingSummaryText" Grid.Row="1"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"
                                                   Margin="0,4,0,0" Visibility="Collapsed" />
                                        <TextBlock x:Name="AlarmStationRankingEmptyText" Text="暂无可排名数据"
                                                   Style="{StaticResource StatisticsEmptyStateTextStyle}"
                                                   Visibility="Collapsed" />
                                    </Grid>
                                </TabItem>
                                <TabItem Header="报警最多车辆">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ItemsControl x:Name="AlarmVehicleRankingItemsControl" ItemTemplate="{StaticResource RankingItemTemplate}"
                                                      VerticalAlignment="Top" />
                                        <TextBlock x:Name="AlarmVehicleRankingSummaryText" Grid.Row="1"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"
                                                   Margin="0,4,0,0" Visibility="Collapsed" />
                                        <TextBlock x:Name="AlarmVehicleRankingEmptyText" Text="暂无可排名数据"
                                                   Style="{StaticResource StatisticsEmptyStateTextStyle}"
                                                   Visibility="Collapsed" />
                                    </Grid>
                                </TabItem>
                                <TabItem Header="通行最多车辆">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ItemsControl x:Name="PassageVehicleRankingItemsControl" ItemTemplate="{StaticResource RankingItemTemplate}"
                                                      VerticalAlignment="Top" />
                                        <TextBlock x:Name="PassageVehicleRankingSummaryText" Grid.Row="1"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"
                                                   Margin="0,4,0,0" Visibility="Collapsed" />
                                        <TextBlock x:Name="PassageVehicleRankingEmptyText" Text="暂无可排名数据"
                                                   Style="{StaticResource StatisticsEmptyStateTextStyle}"
                                                   Visibility="Collapsed" />
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" MinHeight="240" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.35*" />
                        <ColumnDefinition Width="0.65*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource StatisticsSectionStyle}" Margin="0,0,5,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#E8AD52" Width="44"
                                    HorizontalAlignment="Left" />
                            <TextBlock Grid.Row="1" Text="重点异常 / 待处理" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="15" FontWeight="SemiBold" Margin="0,7,0,5" />
                            <Grid Grid.Row="2">
                                <ItemsControl x:Name="RecentExceptionsItemsControl" ItemTemplate="{StaticResource ExceptionItemTemplate}"
                                              VerticalAlignment="Top" />
                                <TextBlock x:Name="RecentExceptionsEmptyText" Text="暂无重点异常"
                                           Style="{StaticResource StatisticsEmptyStateTextStyle}"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource StatisticsSectionStyle}" Margin="5,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{StaticResource AccentBrush}" Width="44"
                                    HorizontalAlignment="Left" />
                            <TextBlock Grid.Row="1" Text="最近通行记录" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="15" FontWeight="SemiBold" Margin="0,7,0,5" />
                            <Grid Grid.Row="2">
                                <DataGrid x:Name="RecentPassagesGrid" Style="{StaticResource StatisticsTableStyle}"
                                          Visibility="Collapsed">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="0.85*" />
                                        <DataGridTextColumn Header="基站" Binding="{Binding StationText}" Width="0.9*" />
                                        <DataGridTextColumn Header="车辆编号" Binding="{Binding VehicleNoText}" Width="0.85*" />
                                        <DataGridTextColumn Header="车辆名称" Binding="{Binding VehicleNameText}" Width="1.1*" />
                                        <DataGridTextColumn Header="判定结果" Binding="{Binding OutcomeText}" Width="0.9*" />
                                        <DataGridTextColumn Header="实际/理论" Binding="{Binding CountText}" Width="0.75*" />
                                        <DataGridTextColumn Header="报警状态" Binding="{Binding AlarmStatusText}" Width="0.85*" />
                                        <DataGridTextColumn Header="通行时长" Binding="{Binding DurationText}" Width="0.85*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="RecentPassagesEmptyText" Text="暂无通行记录"
                                           Style="{StaticResource StatisticsEmptyStateTextStyle}"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
