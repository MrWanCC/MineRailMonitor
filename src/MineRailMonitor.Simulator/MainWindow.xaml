<Window x:Class="MineRailMonitor.Simulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="RFID读卡分站模拟器"
        Width="1180" Height="860" MinWidth="920" MinHeight="640"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="#07111D" Foreground="#EAF6FF" FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" NonClientFrameEdges="None" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0B1C2D" />
            <Setter Property="Foreground" Value="#EAF6FF" />
            <Setter Property="BorderBrush" Value="#244B63" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CaretBrush" Value="#39D5FF" />
            <Setter Property="SelectionBrush" Value="#1D7094" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#39D5FF" />
                    <Setter Property="Background" Value="#0E263B" />
                </Trigger>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background" Value="#081725" />
                    <Setter Property="Foreground" Value="#8EB5CA" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#123B57" />
            <Setter Property="Foreground" Value="#EAF6FF" />
            <Setter Property="BorderBrush" Value="#286482" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A587D" />
                    <Setter Property="BorderBrush" Value="#39D5FF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0D2A40" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="#31546A" />
            <Setter Property="BorderBrush" Value="#31546A" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Margin="1" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3FC9E8" />
                    <Setter Property="BorderBrush" Value="#3FC9E8" />
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter Property="Background" Value="#64E0F5" />
                    <Setter Property="BorderBrush" Value="#64E0F5" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="#081725" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" Focusable="False" IsDirectionReversed="True"
                                   Orientation="{TemplateBinding Orientation}">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="10" />
                                <Setter Property="Width" Value="Auto" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#0C1D2F" />
            <Setter Property="BorderBrush" Value="#173A52" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#54D7FF" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9DBDD0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="#1B4D68" BorderThickness="1" Background="#07111D">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#091A2A" BorderBrush="#2A91B8" BorderThickness="0,0,0,1"
                    Padding="18,0,12,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="8" Background="#0D5378"
                                BorderBrush="#38C6EA" BorderThickness="1" Margin="0,0,11,0">
                            <Grid>
                                <Ellipse Width="19" Height="19" Stroke="#A2F0FF" StrokeThickness="1.5" />
                                <TextBlock Text="R" Foreground="#E8FCFF" FontSize="12" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="RFID读卡分站模拟器" Foreground="#F0FAFF" FontSize="21" FontWeight="SemiBold" />
                            <TextBlock Text="UDP protocol workbench  ·  40-byte frame" Foreground="#6FA9C2" FontSize="11" Margin="1,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Ellipse x:Name="HeaderStatusDot" Width="8" Height="8" Fill="#63E6B0" Margin="0,0,7,0" />
                        <TextBlock x:Name="HeaderStatusText" Text="就绪 · 可发送" Foreground="#9BDFC4"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,18,0" />
                        <Button x:Name="MinimizeWindowButton" Content="—" Width="38" Height="30" Padding="0"
                                Margin="0,0,6,0" FontSize="16" Click="OnMinimizeClick" />
                        <Button x:Name="CloseWindowButton" Content="×" Width="38" Height="30" Padding="0"
                                Background="#3A1C2A" BorderBrush="#70334A" FontSize="18" Click="OnCloseClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18,16,18,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,12,0">
                    <StackPanel>
                        <Border Style="{StaticResource SectionBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="协议数据" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="固定 40 Byte · RFID 模式 04" Foreground="#5D91AA" FontSize="11" Margin="0,4,0,14" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="模拟基站槽位" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox x:Name="StationSelectorComboBox" SelectedIndex="0">
                                            <ComboBoxItem Content="基站槽位 1" />
                                            <ComboBoxItem Content="基站槽位 2" />
                                            <ComboBoxItem Content="基站槽位 3" />
                                            <ComboBoxItem Content="基站槽位 4" />
                                            <ComboBoxItem Content="基站槽位 5" />
                                            <ComboBoxItem Content="基站槽位 6" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="分站地址（HEX）" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="AddressTextBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                        <TextBlock Text="模式" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="04（只读）" IsReadOnly="True" />
                                    </StackPanel>
                                </Grid>
                                <Border Background="#091827" BorderBrush="#173A52" BorderThickness="0,1,0,0" Margin="0,16,0,12" />
                            <TextBlock Text="RFID 槽位（14 个固定槽）" Foreground="#B9D8E8" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,9" />
                            <StackPanel x:Name="RfidInputsPanel" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ScanRfidTextBox" Text="001A" Margin="0,0,6,0" />
                                <Button x:Name="ScanNextButton" Grid.Column="1" Content="扫入下一张" Margin="0,0,8,0" />
                                <TextBox x:Name="RemoveRfidTextBox" Grid.Column="2" Text="001A" Margin="0,0,6,0" />
                                <Button x:Name="RemoveTagButton" Grid.Column="3" Content="移除标签" />
                            </Grid>
                            <TextBlock Text="扫入按当前空槽顺序写入；硬件槽位可稀疏，标签显示统一为 4 位大写 HEX。"
                                       Foreground="#6FA9C2" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="空槽值" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="EmptySlotTextBox" Text="0000" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                        <TextBlock Text="CRC 高位" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="CrcHighTextBox" Text="00" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                        <TextBlock Text="CRC 低位" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="CrcLowTextBox" Text="00" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="TX HEX 预览" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="发送前检查完整数据报内容" Foreground="#5D91AA" FontSize="11" Margin="0,4,0,10" />
                                <TextBox x:Name="TxHexTextBox" Height="76" IsReadOnly="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                                         Foreground="#9CEBFF" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource SectionBorderStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="UDP 应答监听" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="监听上位机请求并按地址返回响应" Foreground="#5D91AA" FontSize="11" Margin="0,4,0,14" />
                            <TextBlock Text="监听 IP" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="LocalIpTextBox" Text="127.0.0.1" Margin="0,0,0,10" />
                            <TextBlock Text="本地端口" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="LocalPortTextBox" Text="62001" Margin="0,0,0,10" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionBorderStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="快速预设" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="快速填充 RFID1~RFID14（槽位不代表车辆顺序）" Foreground="#5D91AA" FontSize="11" Margin="0,4,0,12" />
                            <UniformGrid Columns="2">
                                <Button x:Name="NormalPresetButton" Content="正常 11 节" Margin="0,0,6,8" />
                                <Button x:Name="ShortPresetButton" Content="只发 6 节" Margin="6,0,0,8" />
                                <Button x:Name="TenWagonPresetButton" Content="只有 10 节" Margin="0,0,6,8" />
                                <Button x:Name="DuplicatePresetButton" Content="重复 RFID" Margin="6,0,0,8" />
                                <Button x:Name="MultiHeadPresetButton" Content="多车头 11 节" Margin="0,0,6,8" />
                                <Button x:Name="NoHeadPresetButton" Content="无车头 11 节" Margin="6,0,0,8" />
                                <Button x:Name="FirstNonHeadPresetButton" Content="首位异常 11 节" Margin="0,0,6,8" />
                                <Button x:Name="ClearButton" Content="清空槽位" Margin="6,0,0,0" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="发送控制" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="按上位机请求返回对应基站 40 Byte 响应" Foreground="#5D91AA" FontSize="11" Margin="0,4,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="SendOnceButton" Content="启动查询应答" Background="#0D6B83" BorderBrush="#32CFEA"
                                        Margin="0,0,6,0" />
                                <Button x:Name="StopLoopButton" Grid.Column="1" Content="停止" Background="#3A1C2A"
                                        BorderBrush="#70334A" Margin="6,0,0,0" />
                            </Grid>
                            <Button x:Name="StartLoopButton" Content="启动查询应答" Background="#145A68" BorderBrush="#35C7D8"
                                    Margin="0,10,0,10" />
                            <Grid Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="轮询间隔（由上位机决定）" Foreground="#9DBDD0" VerticalAlignment="Center" />
                                <TextBox x:Name="IntervalTextBox" Grid.Column="1" Text="500" />
                            </Grid>
                            <Border Background="#091827" BorderBrush="#173A52" BorderThickness="0,1,0,0" Margin="0,14,0,10" />
                            <TextBlock x:Name="StatusTextBlock" Foreground="#76E5B2" TextWrapping="Wrap" />
                            <TextBlock x:Name="ErrorTextBlock" Foreground="#FF8795" TextWrapping="Wrap" Margin="0,5,0,0" />
                            <TextBlock x:Name="CounterTextBlock" Foreground="#7FA5B8" Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
