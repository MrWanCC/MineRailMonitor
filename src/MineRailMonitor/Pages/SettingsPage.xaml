<UserControl x:Class="MineRailMonitor.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MineRailMonitor.Pages"
             Background="{StaticResource AppBackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="SettingsPanelStyle" TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
            <Setter Property="Background" Value="#041B30" />
            <Setter Property="BorderBrush" Value="#0B7EBA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="SettingsPageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource PageTitleStyle}">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitleStyle}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SettingsFieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SettingsHelperStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Geometry x:Key="StationSummaryIconGeometry">M4,3 H20 V8 H4 Z M4,10 H20 V15 H4 Z M4,17 H20 V22 H4 Z M7,5.5 H8 M7,12.5 H8 M7,19.5 H8</Geometry>

        <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Background" Value="#061E33" />
            <Setter Property="BorderBrush" Value="#21698F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="SettingsActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="#0A2B46" />
            <Setter Property="BorderBrush" Value="#1A79A8" />
        </Style>

        <Style x:Key="SettingsToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsActionButtonStyle}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="SettingsPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentButtonBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBlueBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SettingsDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsActionButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
            <Setter Property="Background" Value="#211A2A" />
            <Setter Property="Padding" Value="12,0" />
        </Style>

        <Style x:Key="SettingsTableHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
            <Setter Property="Foreground" Value="#BBD8EA" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0" />
        </Style>

        <Style x:Key="SettingsTableTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource SettingsTextBoxStyle}">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="#082A45" />
            <Setter Property="BorderBrush" Value="#1B5B7E" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0B304C" />
                    <Setter Property="BorderBrush" Value="#2B86B5" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="#0B304C" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBlueBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsTableComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="#082A45" />
            <Setter Property="BorderBrush" Value="#1B5B7E" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SettingsTableActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsActionButtonStyle}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Width" Value="72" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="SettingsTableBindButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsTableActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentButtonBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBlueBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="SettingsTableUnbindButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsTableActionButtonStyle}">
            <Setter Property="Background" Value="#0A2B46" />
            <Setter Property="BorderBrush" Value="#547B95" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>

        <Style x:Key="SettingsTableViewButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsTableActionButtonStyle}">
            <Setter Property="Background" Value="#0A2B46" />
            <Setter Property="BorderBrush" Value="#2B86B5" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="SettingsTableConflictButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsTableActionButtonStyle}">
            <Setter Property="Background" Value="#2A200C" />
            <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
        </Style>

        <Style x:Key="SettingsTableRemoveButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsDangerButtonStyle}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Width" Value="52" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="SettingsTableMoreButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsTableActionButtonStyle}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SettingsActionContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="#06233D" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBlueBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="MinWidth" Value="176" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ItemsPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsActionMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontFamily="{TemplateBinding FontFamily}"
                                              TextElement.FontSize="{TemplateBinding FontSize}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuItemBorder" Property="Background" Value="#0C5794" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
                                <Setter TargetName="MenuItemBorder" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsReadOnlyFieldStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StationEditingEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPage}}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsEditableFieldStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StationEditingEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPage}}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsToggleStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="ToggleTrack" Width="38" Height="20" Background="#19374D" BorderBrush="#39627B" BorderThickness="1" CornerRadius="10">
                                <Ellipse x:Name="ToggleThumb" Width="14" Height="14" Fill="#A9C1D0" HorizontalAlignment="Left" Margin="2" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" Content="{TemplateBinding Content}" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="{TemplateBinding FontSize}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleTrack" Property="Background" Value="{StaticResource SuccessBrush}" />
                                <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                <Setter TargetName="ToggleThumb" Property="Fill" Value="#F4FFFB" />
                                <Setter TargetName="ToggleThumb" Property="Margin" Value="20,2,2,2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ToggleTrack" Property="Opacity" Value="0.55" />
                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="28,16,28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xE713;" Style="{StaticResource SegoeFluentIconStyle}" Foreground="{StaticResource PrimaryBlueBrush}" FontSize="28" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock Grid.Column="1" Text="系统设置" Style="{StaticResource SettingsPageTitleStyle}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="›" Foreground="{StaticResource MutedTextBrush}" FontSize="24" VerticalAlignment="Center" Margin="18,0,18,0" />
            <TextBlock Grid.Column="3" Text="系统参数配置" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" VerticalAlignment="Center" />
            <Button x:Name="AboutButton" Grid.Column="4" Content="ⓘ  关于" Style="{StaticResource SettingsToolbarButtonStyle}"
                    Width="82" Margin="16,0,0,0" Click="OnAboutClick" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource SettingsPanelStyle}" Padding="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE713;" Style="{StaticResource SegoeFluentIconStyle}" Foreground="{StaticResource PrimaryBlueBrush}" FontSize="30" Width="34" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="RFID识别参数" Style="{StaticResource SettingsSectionTitleStyle}" FontSize="16" />
                                <TextBlock Text="轮询、标准节数、车辆超时。" Style="{StaticResource SettingsHelperStyle}" Margin="0,1,0,0" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" Background="{StaticResource GridLineBrush}" />

                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="360" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderBrush="{StaticResource GridLineBrush}" BorderThickness="0,0,1,0" Padding="0,0,22,0" Margin="0,0,22,0">
                                <StackPanel>
                                    <TextBlock Text="RFID轮询间隔（ms）" Style="{StaticResource SettingsFieldLabelStyle}" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="280" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="PollIntervalTextBox" Style="{StaticResource SettingsTextBoxStyle}" Height="34" Width="280" HorizontalAlignment="Left"
                                                 TextAlignment="Center"
                                                 IsEnabled="{Binding RfidSettingsEditingEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPage}}}" />
                                        <TextBlock Grid.Column="1" Text="ms" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </Grid>
                                    <TextBlock Text="建议 100-1000ms。" Style="{StaticResource SettingsHelperStyle}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" BorderBrush="{StaticResource GridLineBrush}" BorderThickness="0,0,1,0" Padding="0,0,22,0" Margin="0,0,22,0">
                                <StackPanel>
                                    <TextBlock Text="标准列车节数（含车头）" Style="{StaticResource SettingsFieldLabelStyle}"
                                               ToolTip="提示：包含车头，标准节数计算。" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="280" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ExpectedVehicleCountTextBox" Style="{StaticResource SettingsTextBoxStyle}" Height="34" Width="280" HorizontalAlignment="Left"
                                                 TextAlignment="Center"
                                                 IsEnabled="{Binding RfidSettingsEditingEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPage}}}" />
                                        <TextBlock Grid.Column="1" Text="节" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </Grid>
                                    <TextBlock Text="包含车头，标准节数计算。" Style="{StaticResource SettingsHelperStyle}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" BorderBrush="{StaticResource GridLineBrush}" BorderThickness="0,0,1,0" Padding="0,0,22,0" Margin="0,0,22,0">
                                <StackPanel>
                                    <TextBlock Text="相邻车辆识别超时（秒）" Style="{StaticResource SettingsFieldLabelStyle}" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="280" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="InterVehicleTimeoutTextBox" Style="{StaticResource SettingsTextBoxStyle}" Height="34" Width="280" HorizontalAlignment="Left"
                                                 TextAlignment="Center"
                                                 IsEnabled="{Binding RfidSettingsEditingEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPage}}}" />
                                        <TextBlock Grid.Column="1" Text="秒" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </Grid>
                                    <TextBlock Text="建议 10-60秒。" Style="{StaticResource SettingsHelperStyle}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Padding="12,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="运行参数" Style="{StaticResource SettingsFieldLabelStyle}" Margin="0,0,0,6" />
                                    <Border Background="#0A2B45" CornerRadius="3" Padding="8" Margin="0,0,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE73E;" Style="{StaticResource SegoeFluentIconStyle}" Foreground="{StaticResource SuccessBrush}" FontSize="18" Margin="0,0,8,0" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="当前配置可用" Foreground="{StaticResource SuccessBrush}" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="保存后参数立即生效。" Style="{StaticResource SettingsHelperStyle}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="⟳  恢复默认" Style="{StaticResource SettingsToolbarButtonStyle}" Margin="10,0,0,0"
                                                    IsEnabled="{Binding RfidSettingsEditingEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPage}}}"
                                                    Click="OnRestoreDefaultsClick" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="StationEditorPanel" Grid.Row="1" Style="{StaticResource SettingsPanelStyle}" Padding="12" Margin="0,0,0,10" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE701;" Style="{StaticResource SegoeFluentIconStyle}" Foreground="{StaticResource PrimaryBlueBrush}" FontSize="35" Width="40" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="RFID基站配置" Style="{StaticResource SettingsSectionTitleStyle}" />
                                <TextBlock Text="网络、归属、绑定。" Style="{StaticResource SettingsHelperStyle}" Margin="0,1,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="站场筛选" Style="{StaticResource SettingsFieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="ViewRangeComboBox" Grid.Column="3" Width="126" Height="32" Margin="0,0,12,0"
                                      Style="{StaticResource SettingsTableComboBoxStyle}" SelectedValuePath="Id"
                                      SelectionChanged="OnViewRangeChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button x:Name="AddStationButton" Grid.Column="4" Content="＋  新增基站" Style="{StaticResource SettingsPrimaryButtonStyle}" Width="132"
                                    ToolTip="请选择具体站场后新增；全部站场、未归属不可新增"
                                    IsEnabled="{Binding CanAddStation, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPage}}}"
                                    Click="OnAddStationClick" />
                            <Button x:Name="RefreshStationsButton" Grid.Column="5" Content="⟳  刷新" Style="{StaticResource SettingsToolbarButtonStyle}" Margin="10,0,0,0"
                                    Click="OnRefreshStationsClick" />
                            <Button x:Name="ConfigureYardCommunicationButton" Grid.Column="6" Content="⚙  配置" Style="{StaticResource SettingsToolbarButtonStyle}" Margin="10,0,0,0"
                                    Click="OnConfigureYardCommunicationClick" />
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,8,0,8">
                            <TextBlock x:Name="BindingDiagnosticSummaryText" Style="{StaticResource SettingsHelperStyle}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                        </Grid>

                        <Border x:Name="BindingDiagnosticSummaryPanel" Grid.Row="3" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,8" MinHeight="56">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="#082A45" BorderBrush="{StaticResource GridLineBrush}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,8,0" MinHeight="64">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="38" Height="38" CornerRadius="19" Background="#0B3555" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <Path Data="{StaticResource StationSummaryIconGeometry}" Width="22" Height="22" Stretch="Fill" Stroke="{StaticResource PrimaryBlueBrush}" StrokeThickness="1.7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="基站总数" Style="{StaticResource SettingsHelperStyle}" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="BindingStationCountText" Text="0" Foreground="{StaticResource TextPrimaryBrush}" FontSize="22" FontWeight="SemiBold" />
                                                <TextBlock x:Name="BindingStationHelperText" Text="当前配置设备" Style="{StaticResource SettingsHelperStyle}" VerticalAlignment="Bottom" Margin="14,0,0,2" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="1" Background="#082A45" BorderBrush="{StaticResource GridLineBrush}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,8,0" MinHeight="64">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="38" Height="38" CornerRadius="19" Background="#0B493F" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <Ellipse Width="12" Height="12" Fill="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="已启用" Style="{StaticResource SettingsHelperStyle}" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="BindingEnabledCountText" Text="0 / 0" Foreground="{StaticResource SuccessBrush}" FontSize="22" FontWeight="SemiBold" />
                                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="BindingEnabledRateText" Text="启用率 0%" Style="{StaticResource SettingsHelperStyle}" FontSize="10" />
                                                    <ProgressBar x:Name="BindingEnabledProgressBar" Width="140" Height="5" Minimum="0" Maximum="1" Value="0" Margin="0,3,0,0" Background="#163A54" Foreground="{StaticResource SuccessBrush}" BorderThickness="0" HorizontalAlignment="Left" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2" Background="#082A45" BorderBrush="{StaticResource GridLineBrush}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,8,0" MinHeight="64">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="38" Height="38" CornerRadius="19" Background="#0B3555" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock x:Name="BindingBoundSummaryIcon" Text="&#xE70F;" Style="{StaticResource SegoeFluentIconStyle}" Foreground="{StaticResource PrimaryBlueBrush}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="地图绑定" Style="{StaticResource SettingsHelperStyle}" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="BindingBoundCountText" Text="0 / 0" Foreground="{StaticResource TextPrimaryBrush}" FontSize="22" FontWeight="SemiBold" />
                                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="BindingBoundRateText" Text="完成率 0%" Style="{StaticResource SettingsHelperStyle}" FontSize="10" />
                                                    <ProgressBar x:Name="BindingBoundProgressBar" Width="140" Height="5" Minimum="0" Maximum="1" Value="0" Margin="0,3,0,0" Background="#163A54" Foreground="{StaticResource PrimaryBlueBrush}" BorderThickness="0" HorizontalAlignment="Left" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border x:Name="BindingPendingSummaryCard" Grid.Column="3" Background="#2A200C" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="4" Padding="10,8" MinHeight="64">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="BindingPendingSummaryIconContainer" Width="38" Height="38" CornerRadius="19" Background="#0B3555" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock x:Name="BindingPendingSummaryIcon" Text="&#xE7BA;" Style="{StaticResource SegoeFluentIconStyle}" Foreground="{StaticResource WarningBrush}" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="待处理项" Style="{StaticResource SettingsHelperStyle}" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="BindingPendingCountText" Text="0" Foreground="{StaticResource TextPrimaryBrush}" FontSize="22" FontWeight="SemiBold" />
                                                <TextBlock x:Name="BindingPendingDetailsText" Text="未绑定 0  |  冲突 0  |  重复 0" Foreground="{StaticResource MutedTextBrush}" FontSize="10" VerticalAlignment="Bottom" Margin="8,0,0,2" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="›" Foreground="{StaticResource TextSecondaryBrush}" FontSize="24" VerticalAlignment="Center" Margin="10,0,2,2" IsHitTestVisible="False" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Border x:Name="BindingDiagnosticWarningPanel" Grid.Row="4" Background="#2A200C" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="3" Padding="10,4" Margin="0,0,0,8" Visibility="Collapsed">
                            <TextBlock x:Name="BindingDiagnosticWarningText" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource WarningBrush}" FontSize="11" FontWeight="SemiBold" />
                        </Border>

                        <Grid Grid.Row="5" VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#082A45" BorderBrush="{StaticResource GridLineBrush}" BorderThickness="1" CornerRadius="2">
                                <Grid Height="32">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.55*" />
                                        <ColumnDefinition Width="2.35*" />
                                        <ColumnDefinition Width="1.25*" />
                                        <ColumnDefinition Width="2.15*" />
                                    <ColumnDefinition Width="1.15*" />
                                    <ColumnDefinition Width="2.15*" />
                                    <ColumnDefinition Width="1.45*" />
                                    <ColumnDefinition Width="1.4*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="#" Style="{StaticResource SettingsTableHeaderStyle}" TextAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="基站 / 名称" Style="{StaticResource SettingsTableHeaderStyle}" />
                                    <TextBlock Grid.Column="2" Text="所属站场" Style="{StaticResource SettingsTableHeaderStyle}" />
                                    <TextBlock Grid.Column="3" Text="通信地址（IP:端口）" Style="{StaticResource SettingsTableHeaderStyle}" />
                                    <TextBlock Grid.Column="4" Text="状态" Style="{StaticResource SettingsTableHeaderStyle}" />
                                    <TextBlock Grid.Column="5" Text="地图绑定" Style="{StaticResource SettingsTableHeaderStyle}" />
                                    <TextBlock Grid.Column="6" Text="最后在线时间" Style="{StaticResource SettingsTableHeaderStyle}" />
                                    <TextBlock Grid.Column="7" Text="操作" Style="{StaticResource SettingsTableHeaderStyle}" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" MinHeight="340" MaxHeight="420" VerticalAlignment="Stretch"
                                    BorderBrush="{StaticResource GridLineBrush}" BorderThickness="1,0,1,1">
                                <ListBox x:Name="StationsItemsControl" BorderThickness="0" Background="Transparent" Padding="0,0,0,8"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.CanContentScroll="False"
                                         ScrollViewer.PanningMode="VerticalOnly"
                                         SelectionMode="Single">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Focusable" Value="False" />
                                            <Setter Property="IsTabStop" Value="False" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#061F34" BorderBrush="{StaticResource GridLineBrush}" BorderThickness="0,0,0,1" Padding="0,3">
                                                <Grid MinHeight="48">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="0.55*" />
                                                        <ColumnDefinition Width="2.35*" />
                                                        <ColumnDefinition Width="1.25*" />
                                                        <ColumnDefinition Width="2.15*" />
                                                        <ColumnDefinition Width="1.15*" />
                                                        <ColumnDefinition Width="2.15*" />
                                                        <ColumnDefinition Width="1.45*" />
                                                        <ColumnDefinition Width="1.4*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding DisplayIndex}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                    <Grid Grid.Column="1" Margin="0,0,8,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Path Data="{StaticResource TrainIconGeometry}" Width="20" Height="20" Stretch="Uniform"
                                                              Stroke="#64CFFF" StrokeThickness="1.5" Fill="Transparent" VerticalAlignment="Center" Margin="4,0,10,0" />
                                                        <StackPanel Grid.Column="1">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding DisplayStationId}" Style="{StaticResource SettingsReadOnlyFieldStyle}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding Name}" Style="{StaticResource SettingsReadOnlyFieldStyle}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,0,0" />
                                                            </StackPanel>
                                                            <StackPanel Style="{StaticResource SettingsEditableFieldStyle}">
                                                                <TextBox Style="{StaticResource SettingsTableTextBoxStyle}"
                                                                         IsEnabled="{Binding StationEditingEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPage}}}"
                                                                         Text="{Binding DisplayStationId, Mode=OneWay}" IsReadOnly="True" Focusable="False"
                                                                         ToolTip="稳定标识，创建后不可修改" />
                                                                <TextBox Style="{StaticResource SettingsTableTextBoxStyle}" Margin="0,1,0,0"
                                                                         IsEnabled="{Binding StationEditingEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPage}}}"
                                                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="基站名称" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>

                                                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                                        <StackPanel>
                                                            <TextBlock Style="{StaticResource SettingsReadOnlyFieldStyle}">
                                                                <Run Text="{Binding IpAddress}" />
                                                                <Run Text=":" />
                                                                <Run Text="{Binding Port}" />
                                                            </TextBlock>
                                                                <TextBlock Style="{StaticResource SettingsReadOnlyFieldStyle}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,0,0">
                                                                <Run Text="地址 " />
                                                                <Run Text="{Binding ProtocolAddress}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <StackPanel Style="{StaticResource SettingsEditableFieldStyle}">
                                                            <TextBox Style="{StaticResource SettingsTableTextBoxStyle}"
                                                                     IsEnabled="{Binding StationEditingEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPage}}}"
                                                                     Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" ToolTip="IP地址" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                                <TextBox Style="{StaticResource SettingsTableTextBoxStyle}" Width="86"
                                                                         IsEnabled="{Binding StationEditingEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPage}}}"
                                                                         Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" ToolTip="端口" />
                                                                <TextBox Style="{StaticResource SettingsTableTextBoxStyle}" Width="64" Margin="6,0,0,0"
                                                                         IsEnabled="{Binding StationEditingEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPage}}}"
                                                                         Text="{Binding ProtocolAddress, UpdateSourceTrigger=PropertyChanged}"
                                                                         ToolTip="两位十六进制设备协议地址，例如 01" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding YardDisplayName}" Style="{StaticResource SettingsReadOnlyFieldStyle}" />
                                                        <ComboBox Margin="0,1,0,0"
                                                                  ItemsSource="{Binding YardOptions}" SelectedValuePath="Id"
                                                                  SelectedValue="{Binding YardId, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsEnabled="{Binding StationEditingEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPage}}}"
                                                                  ToolTip="所属站场" DropDownClosed="OnStationYardChanged">
                                                            <ComboBox.Style>
                                                                <Style TargetType="ComboBox" BasedOn="{StaticResource SettingsTableComboBoxStyle}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding StationEditingEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPage}}}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ComboBox.Style>
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding DisplayName}" />
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="4" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="●  已启用" FontSize="12">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsReadOnlyFieldStyle}">
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="●  已停用" FontSize="12">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsReadOnlyFieldStyle}">
                                                                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <CheckBox Content="启用" Margin="0,1,0,0"
                                                                  IsEnabled="{Binding StationEditingEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPage}}}"
                                                                  IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}">
                                                            <CheckBox.Style>
                                                                <Style TargetType="CheckBox" BasedOn="{StaticResource SettingsToggleStyle}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding StationEditingEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPage}}}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </CheckBox.Style>
                                                        </CheckBox>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="8,0">
                                                        <TextBlock Text="{Binding BindingStatusText}" FontSize="12" TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasYardBindingConflict}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding BindingDetailText}" Foreground="{StaticResource TextSecondaryBrush}"
                                                                   FontSize="12" TextWrapping="Wrap" ToolTip="{Binding BindingFullDetails}" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="6" Text="{Binding LastOnlineDisplay}" Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="12" VerticalAlignment="Center" Margin="8,0" />

                                                    <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="绑定地图" Width="84" Margin="0,0,6,0"
                                                                IsEnabled="{Binding BindingEditingEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPage}}}"
                                                                Click="OnBindStationClick">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource SettingsTableBindButtonStyle}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasBinding}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="定位地图" Width="88" Margin="0,0,6,0"
                                                                Click="OnLocateMapPointClick">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource SettingsTableViewButtonStyle}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding HasBinding}" Value="True" />
                                                                                <Condition Binding="{Binding HasYardBindingConflict}" Value="False" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="处理冲突" Width="88" Margin="0,0,6,0"
                                                                Click="OnLocateMapPointClick">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource SettingsTableConflictButtonStyle}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasYardBindingConflict}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="…" Style="{StaticResource SettingsTableMoreButtonStyle}" ToolTip="更多操作" Click="OnMoreActionsClick">
                                                            <Button.ContextMenu>
                                                                <ContextMenu Style="{StaticResource SettingsActionContextMenuStyle}"
                                                                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                                    <MenuItem Header="查看绑定详情" Style="{StaticResource SettingsActionMenuItemStyle}" Click="OnViewMapPointClick" />
                                                                    <MenuItem Header="解绑" Style="{StaticResource SettingsActionMenuItemStyle}" Click="OnUnbindStationClick" />
                                                                    <MenuItem Header="移除" Style="{StaticResource SettingsActionMenuItemStyle}" Click="OnRemoveStationClick" />
                                                                </ContextMenu>
                                                            </Button.ContextMenu>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Grid>
                        <Border Grid.Row="6" BorderBrush="{StaticResource GridLineBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="ValidationText" Foreground="#FF8795" TextWrapping="Wrap" />
                                    <TextBlock Text="修改后请保存；仅启用基站参与采集。" Style="{StaticResource SettingsHelperStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="进入管理员模式" Style="{StaticResource SettingsActionButtonStyle}" Width="160" Margin="12,0,0,0" Click="OnEnterAdminModeClick" />
                                <Button Grid.Column="2" Content="保存设置" Style="{StaticResource SettingsPrimaryButtonStyle}" Width="142" Margin="12,0,0,0" Click="OnSaveClick"
                                        IsEnabled="{Binding RfidSettingsEditingEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPage}}}"
                                        ToolTip="进入管理员模式后可保存设置" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
        </Grid>
    </Grid>
</UserControl>
