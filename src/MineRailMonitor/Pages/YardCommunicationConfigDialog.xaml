<Window x:Class="MineRailMonitor.Pages.YardCommunicationConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MineRailMonitor.Pages"
        Title="独立通信配置"
        Width="720"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource TextPrimaryBrush}"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="ConfigTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#061F35" />
            <Setter Property="BorderBrush" Value="#15516E" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="ConfigButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#082A45" />
            <Setter Property="BorderBrush" Value="#168DCA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ConfigButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ConfigButtonBorder" Property="BorderBrush" Value="#15B9F0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ConfigButtonBorder" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ConfigButtonBorder" Property="Opacity" Value="0.45" />
                                <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConfigPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ConfigButtonStyle}">
            <Setter Property="Background" Value="#087FBA" />
            <Setter Property="BorderBrush" Value="#15B9F0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="ConfigCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="18,0,0,7" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBoxBorder"
                                    Width="14"
                                    Height="14"
                                    Background="#0B3555"
                                    BorderBrush="{TemplateBinding Foreground}"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                                      Data="M 2,7 L 5.5,10.5 L 12,3"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="7,0,0,0"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="#0A3A61" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CheckBoxBorder" Property="Opacity" Value="0.45" />
                                <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource PrimaryBlueBrush}"
            BorderThickness="1"
            CornerRadius="7">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#06233D"
                    BorderBrush="{StaticResource GridLineBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="7,7,0,0"
                    MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid Margin="18,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="4" Height="26" Background="{StaticResource PrimaryBlueBrush}" CornerRadius="2" Margin="0,0,11,0" />
                        <StackPanel>
                            <TextBlock Text="独立通信配置" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="分别配置 560 / 620 站场的本机监听通道" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Button Content="×" Width="36" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource ConfigButtonStyle}"
                            Padding="0" Background="Transparent" BorderBrush="Transparent" FontSize="20" Click="OnCloseClick" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Padding="20,16,20,14">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="配置范围" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock x:Name="ScopeText" Grid.Column="1" Margin="14,0,0,0" FontSize="13" FontWeight="SemiBold" />
                    </Grid>

                    <Border Background="#061F35" BorderBrush="{StaticResource GridLineBrush}" BorderThickness="1" CornerRadius="5" Padding="12,12,12,2">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="站场通信" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBlock Text="每个站场使用独立监听地址和端口" Grid.Column="1" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" />
                            </Grid>

                            <ItemsControl x:Name="YardCommunicationItemsControl"
                                          IsEnabled="{Binding IsEditingEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:YardCommunicationConfigDialog}}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0B3555" BorderBrush="{StaticResource GridLineBrush}" BorderThickness="1" CornerRadius="4" Padding="14,11" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" />
                                                        <TextBlock Text="  ·  独立通道" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding YardId}" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>

                                                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                                    <TextBlock Text="本机监听" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="150" />
                                                            <ColumnDefinition Width="120" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="监听 IP" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,5" />
                                                            <TextBox Text="{Binding ListenIp, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource ConfigTextBoxStyle}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                                            <TextBlock Text="监听端口" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,5" />
                                                            <TextBox Text="{Binding ListenPort, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource ConfigTextBoxStyle}" />
                                                        </StackPanel>
                                                        <CheckBox Grid.Column="2" Content="启用通信"
                                                                  Style="{StaticResource ConfigCheckBoxStyle}"
                                                                  IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" />
                                                    </Grid>
                                                </StackPanel>

                                                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                                    <TextBlock Text="报警 UDP 转发" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="150" />
                                                            <ColumnDefinition Width="120" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="目标 IP" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,5" />
                                                            <TextBox Text="{Binding AlarmForwardIp, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource ConfigTextBoxStyle}"
                                                                     IsEnabled="{Binding AlarmForwardEnabled}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                                            <TextBlock Text="目标端口" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,5" />
                                                            <TextBox Text="{Binding AlarmForwardPort, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource ConfigTextBoxStyle}"
                                                                     IsEnabled="{Binding AlarmForwardEnabled}" />
                                                        </StackPanel>
                                                        <CheckBox Grid.Column="2" Content="启用报警转发"
                                                                  Style="{StaticResource ConfigCheckBoxStyle}"
                                                                  IsChecked="{Binding AlarmForwardEnabled, UpdateSourceTrigger=PropertyChanged}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="#051A2C" BorderBrush="{StaticResource GridLineBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,7,7">
                <Grid Margin="20,0,20,0">
                    <TextBlock x:Name="DialogHintText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="取消" Style="{StaticResource ConfigButtonStyle}" Margin="0,0,10,0" Click="OnCancelClick" />
                        <Button x:Name="SaveButton" Content="保存配置" Style="{StaticResource ConfigPrimaryButtonStyle}" IsDefault="True" Click="OnSaveClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
