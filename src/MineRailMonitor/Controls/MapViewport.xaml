<UserControl x:Class="MineRailMonitor.Controls.MapViewport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MineRailMonitor.Controls"
             Background="{StaticResource MapBackdropBrush}"
             Focusable="True">
    <Grid x:Name="ViewportRoot"
          Background="{StaticResource MapBackdropBrush}"
          ClipToBounds="True"
          Loaded="OnViewportLoaded"
          SizeChanged="OnViewportSizeChanged"
          MouseWheel="OnViewportMouseWheel"
          PreviewMouseLeftButtonDown="OnViewportMouseLeftButtonDown"
          PreviewMouseLeftButtonUp="OnViewportMouseLeftButtonUp"
          MouseMove="OnViewportMouseMove"
          PreviewKeyDown="OnViewportPreviewKeyDown">
        <!-- One map-world coordinate space: the only zoom/pan transform is applied here. -->
        <Canvas x:Name="MapWorld"
                Width="1600"
                Height="900"
                Background="{StaticResource MapBackdropBrush}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                RenderTransformOrigin="0,0">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="MapScaleTransform" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="MapTranslateTransform" X="0" Y="0" />
                </TransformGroup>
            </Canvas.RenderTransform>

            <Image x:Name="BackgroundImage"
                   Width="1600"
                   Height="900"
                   Opacity="0.82"
                   Stretch="Fill"
                   SnapsToDevicePixels="True"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <local:MapLabelLayer x:Name="MapLabelLayerControl"
                                 Width="1600"
                                 Height="900" />
            <local:MapPointLayer x:Name="MapPointLayerControl"
                                 Width="1600"
                                 Height="900" />
            <local:DeviceLayer x:Name="DeviceLayerControl"
                               Width="1600"
                               Height="900" />
            <Canvas x:Name="CalibrationLayer"
                    Width="1600"
                    Height="900"
                    IsHitTestVisible="False" />
        </Canvas>

        <Border x:Name="CalibrationModeBanner"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,14,0,0"
                Padding="14,7"
                Background="#E61C4055"
                BorderBrush="#00C8FF"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="Collapsed">
            <TextBlock Text="● 地图标注编辑模式  选择对象或在底图上添加标注"
                       Foreground="#D9F7FF"
                       FontWeight="SemiBold" />
        </Border>

        <TextBlock x:Name="CalibrationCoordinateText"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Margin="14,0,0,14"
                   Padding="8,5"
                   Background="#D9102030"
                   Foreground="#BFEFFF"
                   FontFamily="Consolas"
                   FontSize="12"
                   Visibility="Collapsed" />

        <Border x:Name="EmptyImageNotice"
                Margin="20"
                Padding="14,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#E6102030"
                BorderBrush="{StaticResource WarningBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Foreground="{StaticResource WarningBrush}"
                           Text="未配置站场底图"
                           FontSize="13"
                           FontWeight="SemiBold" />
                <TextBlock Foreground="{StaticResource MutedTextBrush}"
                           Text="请将真实 CAD 导出的 PNG/JPG 放入项目 maps 目录"
                           FontSize="11"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
