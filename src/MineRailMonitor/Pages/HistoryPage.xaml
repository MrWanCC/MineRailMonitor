<UserControl x:Class="MineRailMonitor.Pages.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="HistoryHeaderStyle" TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
            <Setter Property="Background" Value="#06223A" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style x:Key="HistorySectionBorderStyle" TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
            <Setter Property="Background" Value="#03182B" />
            <Setter Property="BorderBrush" Value="#0D6792" />
            <Setter Property="Padding" Value="9" />
        </Style>
        <Style x:Key="HistorySummaryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#061F36" />
            <Setter Property="BorderBrush" Value="#15516E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style x:Key="HistorySummaryNumberStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="HistorySummaryLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="HistoryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="#0A3F65" />
            <Setter Property="BorderBrush" Value="#168EDC" />
        </Style>
        <Style x:Key="HistoryFooterButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="82" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource HistoryHeaderStyle}" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource HeaderAccentBrush}" CornerRadius="2" Margin="0,8,12,8" />
                <TextBlock Grid.Column="1" Text="历史查询" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="查询历史通过记录、报警记录及识别明细"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                           VerticalAlignment="Center" Margin="18,0,0,0" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource HistorySectionBorderStyle}" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="站场范围" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="YardFilter" Width="150" Height="30" Margin="0,0,14,0"
                              SelectionChanged="OnYardFilterChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="开始时间" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <DatePicker x:Name="FromDatePicker" Width="168" Height="30" Margin="0,0,14,0"
                                Style="{StaticResource HmiDatePickerStyle}"
                                SelectedDateFormat="Short"
                                ToolTip="点击选择开始日期" PreviewMouseLeftButtonDown="OnDatePickerPreviewMouseLeftButtonDown" />
                    <TextBlock Text="结束时间" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <DatePicker x:Name="ToDatePicker" Width="168" Height="30" Margin="0,0,14,0"
                                Style="{StaticResource HmiDatePickerStyle}"
                                SelectedDateFormat="Short"
                                ToolTip="点击选择结束日期" PreviewMouseLeftButtonDown="OnDatePickerPreviewMouseLeftButtonDown" />
                    <TextBlock Text="基站" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="StationFilter" Width="190" Height="30" Margin="0,0,14,0" />
                    <TextBlock Text="车头RFID" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="HeadRfidFilter" Width="126" Height="30" Margin="0,0,14,0" ToolTip="例如：0003 或 0x0003" />
                    <TextBlock Text="结果状态" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="OutcomeFilter" Width="122" Height="30" Margin="0,0,14,0">
                        <ComboBoxItem Content="全部" Tag="" />
                        <ComboBoxItem Content="正常通过" Tag="Completed" />
                        <ComboBoxItem Content="脱节报警" Tag="UncouplingAlarm" />
                    </ComboBox>
                    <Button Content="查询" Width="78" Height="30" MinHeight="30" Background="#087DDD" BorderBrush="#16B8FF" Click="OnQueryClick" />
                    <Button Content="重置" Width="78" Height="30" MinHeight="30" Margin="8,0,0,0" Click="OnResetClick" />
                </WrapPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock x:Name="QueryErrorText" Foreground="#FFFF9B9B" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,8">
            <Border Style="{StaticResource HistorySummaryCardStyle}" Margin="0,0,6,0" BorderBrush="#167EB3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource TrainIconGeometry}" Width="28" Height="28" Stretch="Uniform"
                          Stroke="{StaticResource PrimaryBlueBrush}" StrokeThickness="1.8" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TodayPassageValue" Text="0" Style="{StaticResource HistorySummaryNumberStyle}" />
                        <TextBlock Text="今日通过" Style="{StaticResource HistorySummaryLabelStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource HistorySummaryCardStyle}" Margin="0,0,6,0" BorderBrush="#008F8A">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource SettingsIconGeometry}" Width="28" Height="28" Stretch="Uniform"
                          Stroke="{StaticResource SuccessBrush}" StrokeThickness="1.8" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TodayNormalValue" Text="0" Style="{StaticResource HistorySummaryNumberStyle}" Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock Text="正常通过" Style="{StaticResource HistorySummaryLabelStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource HistorySummaryCardStyle}" Margin="0,0,6,0" BorderBrush="#A43754">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource AlarmIconGeometry}" Width="28" Height="28" Stretch="Uniform"
                          Stroke="{StaticResource AlarmBrush}" StrokeThickness="1.8" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TodayAlarmValue" Text="0" Style="{StaticResource HistorySummaryNumberStyle}" Foreground="{StaticResource AlarmBrush}" />
                        <TextBlock Text="脱节报警" Style="{StaticResource HistorySummaryLabelStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource HistorySummaryCardStyle}" BorderBrush="#167EB3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource QueryIconGeometry}" Width="28" Height="28" Stretch="Uniform"
                          Stroke="{StaticResource PrimaryBlueBrush}" StrokeThickness="1.8" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="HistoryTotalValue" Text="0" Style="{StaticResource HistorySummaryNumberStyle}" />
                        <TextBlock Text="历史总记录" Style="{StaticResource HistorySummaryLabelStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>

        <Border Grid.Row="3" Style="{StaticResource HistorySectionBorderStyle}" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="38" />
                </Grid.RowDefinitions>
                <Grid Margin="6,0,6,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="4" Height="22" Background="{StaticResource HeaderAccentBrush}" CornerRadius="2" Margin="0,0,10,0" />
                        <TextBlock Text="历史记录列表" Style="{StaticResource SectionTitleStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="ListSummaryText" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                </Grid>
                <Grid Grid.Row="1">
                    <DataGrid x:Name="HistoryGrid" Style="{StaticResource IndustrialDataGridStyle}"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="通过时间" Binding="{Binding CompletedAtText}" Width="1.35*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            <DataGridTextColumn Header="基站" Binding="{Binding StationText}" Width="1.35*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            <DataGridTextColumn Header="车头RFID" Binding="{Binding HeadRfidText}" Width="0.8*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            <DataGridTextColumn Header="标准节数" Binding="{Binding ExpectedCountText}" Width="0.7*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            <DataGridTextColumn Header="实际节数" Binding="{Binding DetectedCountText}" Width="0.7*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            <DataGridTextColumn Header="结果" Binding="{Binding OutcomeText}" Width="0.9*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            <DataGridTextColumn Header="清除状态" Binding="{Binding ClearStateText}" Width="0.9*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            <DataGridTemplateColumn Header="详情" Width="0.65*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="查看" Tag="{Binding}" Style="{StaticResource HistoryActionButtonStyle}" Click="OnHistoryDetailsClick" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="NoDataText" Text="暂无历史记录" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" IsHitTestVisible="False" />
                </Grid>
                <DockPanel Grid.Row="2" LastChildFill="False" Margin="6,8,6,0">
                    <TextBlock Text="每页 20 条" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                    <Button x:Name="NextPageButton" DockPanel.Dock="Right" Content="下一页 ›" Style="{StaticResource HistoryFooterButtonStyle}" Click="OnNextPageClick" />
                    <Button x:Name="PreviousPageButton" DockPanel.Dock="Right" Content="‹ 上一页" Style="{StaticResource HistoryFooterButtonStyle}" Margin="8,0,0,0" Click="OnPreviousPageClick" />
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
