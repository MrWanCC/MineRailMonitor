<UserControl x:Class="MineRailMonitor.Pages.MonitorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MineRailMonitor.Controls"
             Focusable="True"
             PreviewKeyDown="OnPreviewKeyDown"
             Background="{StaticResource AppBackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="InfoRowLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="12,1,0,1" />
        </Style>
        <Style x:Key="InfoRowValueStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldValueStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="4,1,10,1" />
        </Style>
        <Style x:Key="InfoDividerStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource GridLineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style x:Key="MonitorPanelBorderStyle" TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style x:Key="CarriageStyle" TargetType="Border">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="17" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="#04B96E" />
            <Setter Property="BorderBrush" Value="#12F39A" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="TrainNumberTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="TrainStatusTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TrainNumberTextStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="运行正常"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="识别中"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="报警停车"><Setter Property="Foreground" Value="{StaticResource AlarmBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AlarmAwareEventRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource IndustrialDataGridRowStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="报警">
                    <Setter Property="Background" Value="#42151D" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AlarmAwareEventCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource IndustrialDataGridCellStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="报警">
                    <Setter Property="Foreground" Value="{StaticResource AlarmBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MapAnnotationToolButtonStyle" TargetType="Button" BasedOn="{StaticResource MapToolButtonStyle}">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="54" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="AnnotationActionButtonStyle" TargetType="Button" BasedOn="{StaticResource MapToolButtonStyle}">
            <Setter Property="Width" Value="78" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="{StaticResource AccentButtonBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBlueBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="AnnotationCancelButtonStyle" TargetType="Button" BasedOn="{StaticResource AnnotationActionButtonStyle}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="#142B43" />
            <Setter Property="BorderBrush" Value="#41627A" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>
        <Style x:Key="OverviewMetricCardStyle" TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
            <Setter Property="Background" Value="#0A2135" />
            <Setter Property="BorderBrush" Value="{StaticResource GridLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="7,5" />
        </Style>
        <Style x:Key="OverviewMetricLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="OverviewMetricValueStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldValueStyle}">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RfidDetailFieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="10,0,4,0" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RfidDetailFieldValueStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldValueStyle}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RfidDetailStateValueStyle" TargetType="TextBlock" BasedOn="{StaticResource RfidDetailFieldValueStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Text}" Value="在线">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Text}" Value="离线">
                    <Setter Property="Foreground" Value="{StaticResource OfflineBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Text}" Value="识别中">
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Text}" Value="脱节报警">
                    <Setter Property="Foreground" Value="{StaticResource AlarmBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Text}" Value="黄色提示">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Text}" Value="清除/等待空槽">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TaskCardBorderStyle" TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
            <Setter Property="Width" Value="168" />
            <Setter Property="Height" Value="156" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="9,8" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="#0B263B" />
            <Setter Property="BorderBrush" Value="#315C76" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="TaskCardStationIdStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldValueStyle}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TaskCardLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TaskCardValueStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldValueStyle}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TaskCardStatusBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TaskCardStatusAccentStyle" TargetType="Border">
            <Setter Property="Width" Value="3" />
            <Setter Property="Margin" Value="0,1,8,1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="190" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,10,0" Style="{StaticResource MonitorPanelBorderStyle}">
                <Grid>
                    <controls:MapViewport x:Name="Map" DeviceSelected="OnDeviceSelected" />

                    <StackPanel HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Orientation="Horizontal"
                                Margin="0,12,12,0">
                        <Button Content="－" ToolTip="缩小" Style="{StaticResource MapToolButtonStyle}" Click="OnZoomOutClick" />
                        <Button Content="＋" ToolTip="放大" Style="{StaticResource MapToolButtonStyle}" Click="OnZoomInClick" />
                        <Button Content="适应视图" Width="72" Style="{StaticResource MapToolButtonStyle}" Click="OnResetClick" />
                        <Button x:Name="MapAnnotationButton"
                                Content="地图标注"
                                Width="82"
                                Visibility="Collapsed"
                                Style="{StaticResource MapToolButtonStyle}"
                                Click="OnMapAnnotationClick" />
                    </StackPanel>

                    <Border x:Name="AnnotationToolbar"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,54,12,0"
                            Padding="6"
                            Background="{StaticResource DeviceMarkerBackgroundBrush}"
                            BorderBrush="#088BC5"
                             BorderThickness="1"
                             CornerRadius="3"
                             Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="AnnotationToolHint"
                                       Text="选择：点击已有标注可编辑，按住拖动可移动；新增工具请点击空白底图。"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       Margin="2,0,2,6"
                                       TextWrapping="Wrap" />
                            <WrapPanel>
                                <Button Content="选择" Tag="Select" Width="58" Style="{StaticResource MapAnnotationToolButtonStyle}" Click="OnMapToolClick" />
                                <Button Content="普通点位" Tag="MapPoint" Width="82" Style="{StaticResource MapAnnotationToolButtonStyle}" Click="OnMapToolClick" />
                                <Button Content="RFID基站" Tag="RfidStation" Width="82" Style="{StaticResource MapAnnotationToolButtonStyle}" Click="OnMapToolClick" />
                                <Button Content="文字标注" Tag="MapLabel" Width="82" Style="{StaticResource MapAnnotationToolButtonStyle}" Click="OnMapToolClick" />
                                <Button Content="删除" Tag="Delete" Width="58" Style="{StaticResource MapAnnotationToolButtonStyle}" Click="OnDeleteAnnotationClick" />
                                <Button Content="保存" Width="58" Style="{StaticResource MapAnnotationToolButtonStyle}" Click="OnSaveAnnotationsClick" />
                                <Button Content="退出编辑" Width="78" Style="{StaticResource MapAnnotationToolButtonStyle}" Click="OnExitMapAnnotationEditClick" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="10,7"
                            Background="{StaticResource DeviceMarkerBackgroundBrush}" BorderBrush="{StaticResource GridLineBrush}"
                            BorderThickness="0,0,0,1" CornerRadius="0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="4" Height="24" Background="{StaticResource PrimaryBlueBrush}" CornerRadius="2" Margin="0,0,10,0" />
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="MapStationTitle" Text="-560水平站场  实时监控" Style="{StaticResource SectionTitleStyle}" FontSize="17" />
                                </StackPanel>
                                <Border Width="28" Height="2" Background="#20C6FF" HorizontalAlignment="Left" Margin="0,5,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Padding="10,6"
                            Background="#E606192B" BorderBrush="{StaticResource GridLineBrush}" BorderThickness="0" CornerRadius="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="图例：" FontWeight="SemiBold" FontSize="11" Margin="0,0,10,0" />
                            <Ellipse Width="16" Height="16" Fill="#07253B" Stroke="#00C8FF" StrokeThickness="2" Margin="0,0,5,0" />
                            <TextBlock Text="RFID点位" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,16,0" />
                            <Rectangle Width="34" Height="3" Fill="#DCEBFA" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Text="轨道线路" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,16,0" />
                            <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,5,0" />
                            <TextBlock Text="正常运行" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,16,0" />
                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,5,0" />
                            <TextBlock Text="识别中" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,16,0" />
                            <Ellipse Width="8" Height="8" Fill="{StaticResource AlarmBrush}" Margin="0,0,5,0" />
                            <TextBlock Text="报警异常" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

        </Grid>

        <Grid Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="330" />
                </Grid.RowDefinitions>

                <Border x:Name="RfidOverviewCard" Grid.Row="0" Style="{StaticResource RightInfoCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource RightCardHeaderStyle}" Padding="12,0">
                            <DockPanel LastChildFill="False">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8A5;" Style="{StaticResource SegoeFluentIconStyle}" Margin="0,0,9,0" Foreground="#39CEFF" FontSize="23" />
                                    <TextBlock Text="RFID运行总览" Style="{StaticResource SectionTitleStyle}" FontSize="18" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Grid x:Name="RfidOverviewContent" Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="122" />
                                <RowDefinition Height="142" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                        <UniformGrid Grid.Row="0" Columns="2" Rows="2" Margin="8,5,8,4">
                            <Border Style="{StaticResource OverviewMetricCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8B5;" Style="{StaticResource SegoeFluentIconStyle}" Foreground="{StaticResource AccentBrush}" FontSize="21" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="OverviewTotalCountText" Text="0" Style="{StaticResource OverviewMetricValueStyle}" HorizontalAlignment="Left" />
                                        <TextBlock Text="基站总数" Style="{StaticResource OverviewMetricLabelStyle}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource OverviewMetricCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE701;" Style="{StaticResource SegoeFluentIconStyle}" Foreground="{StaticResource SuccessBrush}" FontSize="21" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="OverviewOnlineCountText" Text="0" Style="{StaticResource OverviewMetricValueStyle}" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Left" />
                                        <TextBlock Text="在线" Style="{StaticResource OverviewMetricLabelStyle}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource OverviewMetricCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8C8;" Style="{StaticResource SegoeFluentIconStyle}" Foreground="{StaticResource OfflineBrush}" FontSize="21" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="OverviewOfflineCountText" Text="0" Style="{StaticResource OverviewMetricValueStyle}" Foreground="{StaticResource OfflineBrush}" HorizontalAlignment="Left" />
                                        <TextBlock Text="离线" Style="{StaticResource OverviewMetricLabelStyle}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource OverviewMetricCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource SegoeFluentIconStyle}" Foreground="{StaticResource AlarmBrush}" FontSize="21" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="OverviewAlarmCountText" Text="0" Style="{StaticResource OverviewMetricValueStyle}" Foreground="{StaticResource AlarmBrush}" HorizontalAlignment="Left" />
                                        <TextBlock Text="报警" Style="{StaticResource OverviewMetricLabelStyle}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </UniformGrid>
                        <Grid Grid.Row="1" Margin="8,0,8,4">
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource RightInfoRowStyle}" />
                            <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource RightInfoRowStyle}" />
                            <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,6,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="轮询间隔" Style="{StaticResource InfoRowLabelStyle}" />
                                <TextBlock x:Name="OverviewPollIntervalText" Grid.Column="1" Text="-" Style="{StaticResource InfoRowValueStyle}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Grid.Row="0" Grid.Column="1" Margin="6,0,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="最后轮询" Style="{StaticResource InfoRowLabelStyle}" />
                                <TextBlock x:Name="OverviewLastPollText" Grid.Column="1" Text="-" Style="{StaticResource InfoRowValueStyle}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,6,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="今日通过" Style="{StaticResource InfoRowLabelStyle}" />
                                <TextBlock x:Name="OverviewTodayPassageText" Grid.Column="1" Text="0" Style="{StaticResource InfoRowValueStyle}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Grid.Row="1" Grid.Column="1" Margin="6,0,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="今日报警" Style="{StaticResource InfoRowLabelStyle}" />
                                <TextBlock x:Name="OverviewTodayAlarmText" Grid.Column="1" Text="0" Style="{StaticResource InfoRowValueStyle}" Foreground="{StaticResource AlarmBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Grid.Row="2" Grid.Column="0" Margin="0,0,6,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="连接状态" Style="{StaticResource InfoRowLabelStyle}" />
                                <TextBlock x:Name="OverviewDatabaseDisplayText" Grid.Column="1" Text="正常" Style="{StaticResource InfoRowValueStyle}" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Grid.Row="2" Grid.Column="1" Margin="6,0,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="外部接口" Style="{StaticResource InfoRowLabelStyle}" />
                                <TextBlock x:Name="OverviewExternalDisplayText" Grid.Column="1" Text="未接入" Style="{StaticResource InfoRowValueStyle}" Foreground="{StaticResource OfflineBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <TextBlock x:Name="OverviewDatabaseText" Text="正常" Visibility="Collapsed" />
                            <TextBlock x:Name="OverviewExternalText" Text="未接入" Visibility="Collapsed" />
                        </Grid>
                        <StackPanel x:Name="OverviewEmptyState" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0">
                            <TextBlock Text="&#xE8A5;" Style="{StaticResource SegoeFluentIconStyle}" Foreground="{StaticResource AccentBrush}" FontSize="38" HorizontalAlignment="Center" />
                            <TextBlock Text="未选择基站" Foreground="{StaticResource TextPrimaryBrush}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                            <TextBlock Text="点击地图中的RFID基站" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,7,0,0" HorizontalAlignment="Center" />
                            <TextBlock Text="或下方任务卡查看详情" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" />
                        </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Grid x:Name="RfidDetailView" Grid.Row="0" Margin="0,310,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource RightCardHeaderStyle}" Padding="12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8A5;" Style="{StaticResource SegoeFluentIconStyle}" Margin="0,0,8,0" Foreground="#39CEFF" FontSize="18" />
                            <TextBlock x:Name="RfidDetailHeaderText" Text="RFID基站详情" Style="{StaticResource SectionTitleStyle}" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                <Border x:Name="RfidStationStatusCard" Grid.Row="1" Style="{StaticResource RightInfoCardStyle}" BorderThickness="0" Background="Transparent">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource RightCardBodyFrameStyle}" BorderThickness="0" Background="Transparent">
                        <Grid x:Name="SelectedDeviceInfo" Margin="2,3,2,3">
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" /><ColumnDefinition Width="0.9*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource RightInfoRowStyle}" />
                            <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource RightInfoRowStyle}" />
                            <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource RightInfoRowStyle}" />
                            <Border Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource RightInfoRowStyle}" />
                            <Border Grid.Row="4" Grid.ColumnSpan="2" Style="{StaticResource RightInfoRowStyle}" />
                            <Border Grid.Row="0" Grid.Column="1" BorderBrush="{StaticResource GridLineBrush}" BorderThickness="1,0,0,0" Margin="0,5,0,5" />
                            <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource GridLineBrush}" BorderThickness="1,0,0,0" Margin="0,5,0,5" />
                            <Border Grid.Row="2" Grid.Column="1" BorderBrush="{StaticResource GridLineBrush}" BorderThickness="1,0,0,0" Margin="0,5,0,5" />
                            <Border Grid.Row="3" Grid.Column="1" BorderBrush="{StaticResource GridLineBrush}" BorderThickness="1,0,0,0" Margin="0,5,0,5" />
                            <Border Grid.Row="4" Grid.Column="1" BorderBrush="{StaticResource GridLineBrush}" BorderThickness="1,0,0,0" Margin="0,5,0,5" />

                            <Grid Grid.Row="0" Grid.Column="0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="基站名称" Style="{StaticResource RfidDetailFieldLabelStyle}" />
                                <TextBlock x:Name="SelectedRfidStationNameText" Grid.Column="1" Text="-" Style="{StaticResource RfidDetailFieldValueStyle}" />
                            </Grid>
                            <Grid Grid.Row="0" Grid.Column="1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="StationId" Style="{StaticResource RfidDetailFieldLabelStyle}" />
                                <TextBlock x:Name="SelectedRfidStationIdText" Grid.Column="1" Text="-" Style="{StaticResource RfidDetailFieldValueStyle}" FontFamily="Consolas" />
                            </Grid>
                            <Grid Grid.Row="1" Grid.Column="0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="通信状态" Style="{StaticResource RfidDetailFieldLabelStyle}" />
                                <TextBlock x:Name="SelectedRfidCommunicationText" Grid.Column="1" Text="-" Style="{StaticResource RfidDetailStateValueStyle}" />
                            </Grid>
                            <Grid Grid.Row="1" Grid.Column="1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="工作状态" Style="{StaticResource RfidDetailFieldLabelStyle}" />
                                <TextBlock x:Name="SelectedRfidBusinessStateText" Grid.Column="1" Text="-" Style="{StaticResource RfidDetailStateValueStyle}" />
                            </Grid>
                            <Grid Grid.Row="2" Grid.Column="0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="通信地址" Style="{StaticResource RfidDetailFieldLabelStyle}" />
                                <TextBlock x:Name="SelectedRfidEndpointText" Grid.Column="1" Text="-" Style="{StaticResource RfidDetailFieldValueStyle}" FontFamily="Consolas" />
                            </Grid>
                            <Grid Grid.Row="2" Grid.Column="1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="协议地址" Style="{StaticResource RfidDetailFieldLabelStyle}" />
                                <TextBlock x:Name="SelectedRfidProtocolAddressText" Grid.Column="1" Text="-" Style="{StaticResource RfidDetailFieldValueStyle}" FontFamily="Consolas" />
                            </Grid>
                            <Grid Grid.Row="3" Grid.Column="0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="最后通信" Style="{StaticResource RfidDetailFieldLabelStyle}" />
                                <TextBlock x:Name="SelectedRfidLastCommunicationText" Grid.Column="1" Text="-" Style="{StaticResource RfidDetailFieldValueStyle}" FontFamily="Consolas" />
                            </Grid>
                            <Grid Grid.Row="3" Grid.Column="1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="本次识别" Style="{StaticResource RfidDetailFieldLabelStyle}" />
                                <TextBlock x:Name="SelectedRfidProgressText" Grid.Column="1" Text="-" Style="{StaticResource RfidDetailFieldValueStyle}" FontFamily="Consolas" />
                            </Grid>
                            <Grid Grid.Row="4" Grid.Column="0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="最新RFID" Style="{StaticResource RfidDetailFieldLabelStyle}" />
                                <TextBlock x:Name="SelectedDeviceLatestRfid" Grid.Column="1" Text="-" Style="{StaticResource RfidDetailFieldValueStyle}" FontFamily="Consolas" />
                            </Grid>
                            <Grid Grid.Row="4" Grid.Column="1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="有效RFID" Style="{StaticResource RfidDetailFieldLabelStyle}" />
                                <TextBlock x:Name="SelectedRfidValidCountText" Grid.Column="1" Text="-" Style="{StaticResource RfidDetailFieldValueStyle}" FontFamily="Consolas" />
                            </Grid>
                        </Grid>
                        </Border>
                        <StackPanel x:Name="AnnotationEditEmptyState"
                                    Grid.Row="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="18"
                                    Visibility="Collapsed">
                            <TextBlock Text="&#xE70F;"
                                       Style="{StaticResource SegoeFluentIconStyle}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="34"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="地图标注编辑"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,0" />
                            <TextBlock Text="请选择编辑工具，然后在地图上新增或选择标注。"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,7,0,0" />
                        </StackPanel>
                        <Border x:Name="AnnotationEditor"
                                Grid.Row="0"
                                Padding="4,0,4,4"
                                Background="{StaticResource CardBackgroundBrush}"
                                Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock x:Name="AnnotationEditorTitle" Text="地图标注属性" Style="{StaticResource SectionTitleStyle}" FontSize="14" Margin="0,0,0,4" />
                                    <TextBlock x:Name="AnnotationTypeText" Text="普通点位" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,5" />
                                    <TextBlock x:Name="AnnotationNameLabel" Text="名称" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="AnnotationNameBox" Margin="0,2,0,4" Height="26" />
                                    <TextBlock x:Name="AnnotationTextLabel" Text="文字" Style="{StaticResource FieldLabelStyle}" Visibility="Collapsed" />
                                    <TextBox x:Name="AnnotationTextBox" Margin="0,2,0,4" Height="26" Visibility="Collapsed" />
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="CAD X" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox x:Name="AnnotationCadXBox" Margin="0,2,0,0" Height="26" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="CAD Y" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox x:Name="AnnotationCadYBox" Margin="0,2,0,0" Height="26" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="AnnotationRfidStationLabel" Text="绑定RFID基站" Style="{StaticResource FieldLabelStyle}" Visibility="Collapsed" />
                                    <ComboBox x:Name="AnnotationRfidStationComboBox"
                                              Margin="0,2,0,5"
                                              Height="26"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="StationId"
                                              Visibility="Collapsed" />
                                    <Grid x:Name="AnnotationLabelPropertiesGrid" Margin="0,0,0,4" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="旋转" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox x:Name="AnnotationRotationBox" Margin="0,2,0,0" Height="26" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="字号" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox x:Name="AnnotationTextHeightBox" Margin="0,2,0,0" Height="26" />
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox x:Name="AnnotationEnabledCheckBox" Content="启用显示" ToolTip="取消后该标注不会显示在地图上" IsChecked="True" Margin="0,1,0,8" />
                                    <WrapPanel>
                                        <Button Content="应用修改" Style="{StaticResource AnnotationActionButtonStyle}" Click="OnAnnotationApplyClick" />
                                        <Button Content="取消修改" Style="{StaticResource AnnotationCancelButtonStyle}" Click="OnAnnotationCancelClick" />
                                    </WrapPanel>
                                    <Border Margin="0,9,0,0" Padding="8,6" Background="#0B2A43" BorderBrush="#174767" BorderThickness="1" CornerRadius="3">
                                        <TextBlock Text="提示：修改先保存在内存；点击工具栏“保存”后才写入站场配置。" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <StackPanel Visibility="Collapsed">
                            <TextBlock x:Name="SelectedDeviceTitle" />
                            <TextBlock x:Name="SelectedDeviceCadX" />
                            <TextBlock x:Name="SelectedDeviceCadY" />
                            <TextBlock x:Name="SelectedDeviceId" />
                            <TextBlock x:Name="SelectedDeviceStation" />
                            <TextBlock x:Name="SelectedDeviceStatus" />
                            <TextBlock x:Name="SelectedDeviceHeadRfid" />
                            <TextBlock x:Name="SelectedDeviceProgress" />
                            <TextBlock x:Name="SelectedDeviceLastCommunication" />
                        </StackPanel>
                    </Grid>
                </Border>

                </Grid>

                <Border x:Name="SystemStatusCard" Grid.Row="2" MinHeight="150" Style="{StaticResource RightInfoCardStyle}" Margin="0" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Border Style="{StaticResource RightCardHeaderStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE713;" Style="{StaticResource SegoeFluentIconStyle}" Width="Auto" Margin="0,0,10,0" Foreground="#39CEFF" />
                                <TextBlock Text="系统状态" Style="{StaticResource SectionTitleStyle}" FontSize="17" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="SystemStatusContent" Grid.Row="1" VerticalAlignment="Top" Margin="16,8,16,0">
                            <UniformGrid Columns="2" Rows="2" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Margin="4,1,4,1">
                                    <Ellipse x:Name="SystemDatabaseStatusDot" Width="10" Height="10" Fill="{StaticResource SuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SystemDatabaseStatusText" Text="数据库 正常" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="4,1,4,1">
                                    <Ellipse x:Name="SystemRfidStatusDot" Width="10" Height="10" Fill="{StaticResource OfflineBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SystemRfidStatusText" Text="RFID基站 未配置" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="4,1,4,1">
                                    <Ellipse x:Name="SystemExternalStatusDot" Width="10" Height="10" Fill="{StaticResource OfflineBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SystemExternalStatusText" Text="外部接口 未接入" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock x:Name="RecognitionSnapshotText" Text="当前列车：-" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="10" Margin="4,3,4,0" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                            <WrapPanel HorizontalAlignment="Center" Margin="0,3,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="RealtimeStationSummaryText" Text="在线基站 0/0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,14,0" />
                                <TextBlock x:Name="RecognizingSummaryText" Text="正在识别 0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,14,0" />
                                <TextBlock x:Name="AlarmSummaryText" Text="当前报警 0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                            </WrapPanel>
                            <WrapPanel HorizontalAlignment="Center" Margin="0,2,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="TodayPassageSummaryText" Text="今日通过 0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,14,0" />
                                <TextBlock x:Name="TodayNormalSummaryText" Text="今日正常 0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,14,0" />
                                <TextBlock x:Name="TodayAlarmSummaryText" Text="今日脱节 0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                            </WrapPanel>
                            <TextBlock x:Name="StationHistoricalSummaryText" Text="按基站通过：-" Foreground="{StaticResource SubtleTextBrush}"
                                       FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                        </StackPanel>
                        <Border x:Name="RecognitionNotice"
                                Grid.Row="2"
                                Margin="4,5,4,0"
                                Padding="8,4"
                                BorderThickness="1"
                                CornerRadius="3"
                                Visibility="Collapsed">
                            <TextBlock x:Name="RecognitionNoticeText"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="RfidAlarmCard" Grid.Row="1" Style="{StaticResource RightInfoCardStyle}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource RightCardHeaderStyle}">
                            <DockPanel LastChildFill="False">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource SegoeFluentIconStyle}" Margin="0,0,9,0" Foreground="{StaticResource AlarmBrush}" FontSize="20" />
                                    <TextBlock Text="报警信息" Style="{StaticResource SectionTitleStyle}" FontSize="17" VerticalAlignment="Center" />
                                    <Border Background="{StaticResource AlarmBrush}" CornerRadius="8" Width="17" Height="17" Margin="8,1,0,0">
                                        <TextBlock x:Name="RfidAlarmCountText" Text="0" Foreground="{StaticResource TextPrimaryBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="更多  ›" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <Grid Grid.Row="1" Margin="8,3,8,7">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66" />
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="时间" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="基站" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="报警类型" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="报警描述" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Grid.Row="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="RfidAlarmItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="28">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="66" />
                                                        <ColumnDefinition Width="78" />
                                                        <ColumnDefinition Width="78" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.ColumnSpan="4" Style="{StaticResource RightInfoRowStyle}" />
                                                    <TextBlock Text="{Binding Time}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Station}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding AlarmType}" Foreground="{StaticResource AlarmBrush}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{Binding AlarmDescription}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock x:Name="RfidAlarmEmptyText" Text="暂无报警信息" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
        </Grid>

        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource MonitorPanelBorderStyle}" Margin="0,0,10,0" Padding="10,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8A5;" Style="{StaticResource SegoeFluentIconStyle}" Margin="0,0,9,0" Foreground="#39CEFF" FontSize="21" />
                        <TextBlock Text="当前识别任务" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                        <TextBlock x:Name="RfidTaskSummaryText" Text="当前活动数量 0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="12,2,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,2,0,0">
                    <ItemsControl x:Name="RfidTaskItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TaskCardBorderStyle}"
                                        BorderBrush="{Binding BorderBrush}"
                                        MouseLeftButtonUp="OnRfidTaskCardClick">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Style="{StaticResource TaskCardStatusAccentStyle}"
                                                Background="{Binding StatusForeground}" />
                                        <Grid Grid.Column="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="27" />
                                                <RowDefinition Height="27" />
                                                <RowDefinition Height="12" />
                                                <RowDefinition Height="28" />
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" BorderBrush="#1C425A" BorderThickness="0,0,0,1" Padding="0,0,0,3">
                                                <DockPanel>
                                                    <TextBlock Text="{Binding StationId}" Style="{StaticResource TaskCardStationIdStyle}" />
                                                    <Border DockPanel.Dock="Right"
                                                            Style="{StaticResource TaskCardStatusBadgeStyle}"
                                                            Background="{Binding StatusBackground}"
                                                            BorderBrush="{Binding StatusForeground}">
                                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusForeground}" FontSize="10" HorizontalAlignment="Center" />
                                                    </Border>
                                                </DockPanel>
                                            </Border>
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="当前车头" Style="{StaticResource TaskCardLabelStyle}" />
                                                <TextBlock Grid.Column="1" Text="{Binding HeadRfid}" Style="{StaticResource TaskCardValueStyle}" FontFamily="Consolas" />
                                            </Grid>
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="识别进度" Style="{StaticResource TaskCardLabelStyle}" />
                                                <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Style="{StaticResource TaskCardValueStyle}" FontSize="12" />
                                            </Grid>
                                            <ProgressBar Grid.Row="3" Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100" Height="7" Background="#163A54" Foreground="{Binding ProgressBrush}" BorderThickness="0" VerticalAlignment="Center" />
                                            <Grid Grid.Row="4">
                                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="最新识别" Style="{StaticResource TaskCardLabelStyle}" />
                                                <TextBlock Grid.Column="1" Text="{Binding LatestRecognitionTime}" Style="{StaticResource TaskCardValueStyle}" FontSize="11" />
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <DataGrid x:Name="VehicleGrid" Visibility="Collapsed" />
        <DataGrid x:Name="RuntimeEventsGrid" Visibility="Collapsed" />
    </Grid>
</UserControl>
