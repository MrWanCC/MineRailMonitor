<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <add key="RfidUdpListenAddress" value="127.0.0.1" />
    <add key="RfidUdpListenPort" value="62002" />
    <add key="EmptyRfidValue" value="0" />
    <!-- Default for local/demo use. Override with a local config value or MINE_RAIL_ADMIN_PASSWORD in deployed environments. -->
    <add key="AdminPassword" value="admin123" />
  </appSettings>
</configuration>
